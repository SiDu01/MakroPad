<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.ConnectionView"
             x:DataType="vm:ShellViewModel">
    <ScrollViewer Classes="pageContent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="Verbindung" />
                <TextBlock Classes="muted" Text="Serielle Verbindung, Port-Auswahl und Auto-Connect." />
            </StackPanel>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Verbindung" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="label" Text="Port" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Classes="secondary" Content="Aktualisieren"
                                    Command="{Binding RefreshPortsCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Classes="primary" Content="Verbinden"
                                    Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Button Classes="secondary" Content="Auto-Connect"
                                Command="{Binding AutoConnectCommand}" HorizontalAlignment="Stretch" />
                        <Button Classes="danger" Content="Trennen"
                                Command="{Binding DisconnectCommand}" HorizontalAlignment="Stretch" />
                        <CheckBox Content="Beim Start automatisch verbinden" IsChecked="{Binding AutoConnect}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Classes="panel">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Status" FontSize="15" FontWeight="SemiBold" />
                        <Border Classes="statusPill" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Ellipse Width="9" Height="9" Fill="{Binding ConnectionStatusBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="muted" Text="{Binding SelectedPortDisplay, StringFormat='Aktiver Port: {0}'}" />

                        <Separator Margin="0,4" />
                        <TextBlock Classes="label" Text="OLED Test-Nachricht" />
                        <TextBox Text="{Binding DisplayText}" />
                        <Button Classes="primary" Content="An Display senden"
                                Command="{Binding SendDisplayMessageCommand}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
