<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        xmlns:views="using:MakroPad.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="MakroPad.App.Views.Shell"
        x:DataType="vm:ShellViewModel"
        Icon="/Assets/makropad.png"
        Title="MakroPad"
        Width="1180"
        Height="760"
        MinWidth="1000"
        MinHeight="640">

    <Design.DataContext>
        <vm:ShellViewModel/>
    </Design.DataContext>

    <Grid ColumnDefinitions="Auto,*">

        <!-- Navigation rail -->
        <Border Grid.Column="0" Classes="navRail">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Brand -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Spacing="12"
                            Margin="4,2,4,8">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="10"
                            Background="{DynamicResource AppAccentSoftBrush}"
                            BorderBrush="{DynamicResource AppAccentBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Margin="8">
                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                            <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Classes="brandTitle" Text="MakroPad" FontSize="18" />
                        <TextBlock Classes="brandSubtitle" Text="Macro controller" />
                    </StackPanel>
                </StackPanel>

                <!-- Sections -->
                <StackPanel Grid.Row="1" Spacing="0" Margin="0,14,0,0">
                    <Button Classes="navItem"
                            Classes.active="{Binding IsPadSelected}"
                            Command="{Binding ShowPadCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="navIcon large" Data="{StaticResource NavPadIcon}" />
                            <TextBlock Text="Pad" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="navItem"
                            Classes.active="{Binding IsDisplaySelected}"
                            Command="{Binding ShowDisplayCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="navIcon large" Data="{StaticResource NavDisplayIcon}" />
                            <TextBlock Text="Display" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Classes="navGroup" Text="SYSTEM" />

                    <Button Classes="navItem"
                            Classes.active="{Binding IsConnectionSelected}"
                            Command="{Binding ShowConnectionCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="navIcon large" Data="{StaticResource NavConnectionIcon}" />
                            <TextBlock Text="Verbindung" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="navItem"
                            Classes.active="{Binding IsSettingsSelected}"
                            Command="{Binding ShowSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="navIcon large" Data="{StaticResource NavSettingsIcon}" />
                            <TextBlock Text="Einstellungen" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="navItem"
                            Classes.active="{Binding IsDiagnosticsSelected}"
                            Command="{Binding ShowDiagnosticsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Classes="navIcon large" Data="{StaticResource NavDiagnosticsIcon}" />
                            <TextBlock Text="Diagnose" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Spacing="12">
                    <Button Classes="primary"
                            HorizontalAlignment="Stretch"
                            Content="Speichern"
                            Command="{Binding SaveConfigCommand}"
                            ToolTip.Tip="Konfiguration speichern" />

                    <Border Classes="statusPill">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding ConnectionStatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Button Classes="secondary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{Binding ThemeToggleHint}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Panel Width="18" Height="18">
                                <Path Classes="navIcon large"
                                      IsVisible="{Binding IsDarkTheme}"
                                      Data="{StaticResource NavThemeLightIcon}" />
                                <Path Classes="navIcon large"
                                      IsVisible="{Binding !IsDarkTheme}"
                                      Data="{StaticResource NavThemeDarkIcon}" />
                            </Panel>
                            <TextBlock Text="Design wechseln" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content host -->
        <Panel Grid.Column="1">
            <views:PadView IsVisible="{Binding IsPadSelected}" />
            <views:DisplayView IsVisible="{Binding IsDisplaySelected}" />
            <views:ConnectionView IsVisible="{Binding IsConnectionSelected}" />
            <views:SettingsView IsVisible="{Binding IsSettingsSelected}" />
            <views:DiagnosticsView IsVisible="{Binding IsDiagnosticsSelected}" />
        </Panel>
    </Grid>
</Window>
