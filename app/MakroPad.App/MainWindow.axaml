<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        x:Class="MakroPad.App.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="MakroPad"
        Icon="avares://MakroPad.App/Assets/makropad.ico"
        Width="1320" Height="800" MinWidth="1040" MinHeight="640">
    <DockPanel>
        <Border DockPanel.Dock="Top" Height="58" Padding="36,0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource OfflineBrush}" IsVisible="{Binding !IsConnected}" />
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource OnlineBrush}" IsVisible="{Binding IsConnected}" />
                    <TextBlock Text="{Binding ConnectionText}" FontSize="14" Foreground="{DynamicResource InkMutedBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="MakroPad" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,44,0" />
                    <Button Classes="tab" Classes.active="{Binding IsPad}" Content="Pad"
                            Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:AppPage.Pad}" />
                    <Button Classes="tab" Classes.active="{Binding IsDiagnostics}" Content="Diagnose"
                            Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:AppPage.Diagnostics}" />
                    <Button Classes="tab" Classes.active="{Binding IsSettings}" Content="Einstellungen"
                            Command="{Binding ShowCommand}" CommandParameter="{x:Static vm:AppPage.Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>
</Window>
