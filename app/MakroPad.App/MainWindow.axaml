<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:MakroPad.App"
        x:Class="MakroPad.App.MainWindow"
        x:DataType="app:MainViewModel"
        Title="MakroPad"
        Icon="avares://MakroPad.App/Assets/makropad.ico"
        Width="900" Height="640">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" FontSize="18" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Top" IsVisible="{Binding IsSimulator}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1"
                CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock Text="Simulator" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SimulatorButtons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:Int32">
                            <Button Content="{Binding}" Width="44" Margin="0,0,6,6"
                                    Command="{Binding $parent[ItemsControl].((app:MainViewModel)DataContext).PressButtonCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="Slider 1" VerticalAlignment="Center" />
                    <Slider Width="320" Minimum="0" Maximum="1000" Value="{Binding SliderValue}" />
                    <TextBlock Text="{Binding SliderValue}" VerticalAlignment="Center" />
                    <Button Content="Abziehen simulieren" Command="{Binding SimulateUnplugCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Leeren" Command="{Binding ClearLogCommand}" />
            <TextBlock Text="Protokoll" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox ItemsSource="{Binding Log}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12" />
    </DockPanel>
</Window>
