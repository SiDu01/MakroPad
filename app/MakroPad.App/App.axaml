<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MakroPad.App.App"
             xmlns:local="using:MakroPad.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MakroPad.App/Themes/NavIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark"
                                       Accent="#3B9EFF"
                                       RegionColor="#080C12"
                                       ErrorText="#F08080" />
                <ColorPaletteResources x:Key="Light"
                                       Accent="#2563EB"
                                       RegionColor="#EEF2F7"
                                       ErrorText="#DC2626" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://MakroPad.App/Themes/AppTheme.axaml" />
    </Application.Styles>
</Application>
