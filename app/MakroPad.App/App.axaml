<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MakroPad.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#2DD4BF" RegionColor="#0E1011" ErrorText="#F08080" />
                <ColorPaletteResources x:Key="Light" Accent="#0D9488" RegionColor="#EDF1F0" ErrorText="#DC2626" />
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
