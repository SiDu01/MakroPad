<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             xmlns:controls="using:MakroPad.App.Controls"
             x:Class="MakroPad.App.Controls.PageHeader"
             x:DataType="vm:MainWindowViewModel">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Classes="sectionTitle"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=controls:PageHeader}}" />
            <TextBlock Classes="muted"
                       Text="{Binding Subtitle, RelativeSource={RelativeSource AncestorType=controls:PageHeader}}" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
            <TextBlock Classes="muted"
                       IsVisible="{Binding ShowProfileBadge, RelativeSource={RelativeSource AncestorType=controls:PageHeader}}"
                       Text="{Binding ActiveProfileName, StringFormat='Profil: {0}'}"
                       VerticalAlignment="Center" />
            <Button Classes="secondary"
                    Content="Load"
                    IsVisible="{Binding ShowConfigActions, RelativeSource={RelativeSource AncestorType=controls:PageHeader}}"
                    Command="{Binding LoadConfigCommand}" />
            <Button Classes="primary"
                    Content="Save"
                    IsVisible="{Binding ShowConfigActions, RelativeSource={RelativeSource AncestorType=controls:PageHeader}}"
                    Command="{Binding SaveConfigCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
