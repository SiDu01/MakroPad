<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.SettingsView"
             x:DataType="vm:ShellViewModel">
    <ScrollViewer Classes="pageContent">
        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                <TextBlock Classes="muted"
                           Text="App-Optionen: Action-Timeout, Volume-Deadband, Now Playing, Design." />
            </StackPanel>
            <Border Classes="panel">
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="Die App-Einstellungen werden in einem spaeteren Schritt aufgebaut." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
