<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="34" Margin="36,28,36,28" MaxWidth="620" HorizontalAlignment="Left">
            <StackPanel.Styles>
                <Style Selector="DockPanel.row">
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
                <Style Selector="DockPanel.row > TextBlock">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
                <Style Selector="ToggleSwitch">
                    <Setter Property="OnContent" Value="" />
                    <Setter Property="OffContent" Value="" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
            </StackPanel.Styles>

            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Start" />
                <DockPanel Classes="row">
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartWithWindows}" />
                    <TextBlock Text="Mit Windows starten" />
                </DockPanel>
                <DockPanel Classes="row">
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding StartInTray}" />
                    <TextBlock Text="Ohne Fenster starten, nur im Infobereich" />
                </DockPanel>
                <TextBlock Classes="muted"
                           Text="Das Fenster zu schließen beendet die App nicht. Sie läuft im Infobereich weiter, beenden kannst du sie über ihr Menü dort." />
            </StackPanel>

            <StackPanel Spacing="8" DataContext="{Binding AutoProfile}" x:DataType="vm:AutoProfileViewModel">
                <TextBlock Classes="h2" Text="Profile automatisch wechseln" />
                <DockPanel Classes="row">
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Enabled}" />
                    <TextBlock Text="Profil wechseln, wenn ein anderes Programm in den Vordergrund kommt" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Classes="muted"
                           Text="Ein Profil, das du selbst gewählt hast, bleibt aktiv, bis du zu einem anderen Programm wechselst. Das MakroPad-Fenster selbst löst keinen Wechsel aus." />

                <StackPanel Spacing="8" IsEnabled="{Binding Enabled}" Margin="0,8,0,0">
                    <TextBlock Classes="muted" Text="Noch keine Regeln. Lege unten fest, welches Profil bei welchem Programm aktiv sein soll."
                               IsVisible="{Binding !HasRules}" />
                    <ItemsControl ItemsSource="{Binding Rules}" IsVisible="{Binding HasRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProfileRuleRow">
                                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Classes="quiet" Content="Entfernen"
                                                Command="{Binding $parent[ItemsControl].((vm:AutoProfileViewModel)DataContext).RemoveRuleCommand}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock VerticalAlignment="Center" FontSize="15">
                                            <Run Text="{Binding Process}" FontWeight="SemiBold" />
                                            <Run Text=" im Vordergrund aktiviert " Foreground="{DynamicResource InkMutedBrush}" />
                                            <Run Text="{Binding Profile}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto,180,Auto" Margin="0,8,0,0">
                        <TextBox Text="{Binding NewProcess}" PlaceholderText="Programm, z. B. Discord" />
                        <TextBlock Grid.Column="1" Text="aktiviert" VerticalAlignment="Center" Margin="10,0"
                                   Foreground="{DynamicResource InkMutedBrush}" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding NewProfile}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="3" Content="Regel hinzufügen" Command="{Binding AddRuleCommand}" Margin="8,0,0,0" />
                    </Grid>
                    <StackPanel IsVisible="{Binding HasRecent}">
                        <TextBlock Classes="muted" FontSize="12.5" Text="Zuletzt im Vordergrund:" Margin="0,2,0,4" />
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" Margin="0,0,6,6" Padding="10,4"
                                            Command="{Binding $parent[ItemsControl].((vm:AutoProfileViewModel)DataContext).UseProcessCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <DockPanel Classes="row" Margin="0,10,0,0">
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding FallbackOptions}" SelectedItem="{Binding Fallback}" MinWidth="180">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:FallbackOption">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Bei allen anderen Programmen" />
                    </DockPanel>
                    <TextBlock Classes="caution" Text="{Binding Error}"
                               IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Darstellung" />
                <DockPanel Classes="row">
                    <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThemeOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Farbschema" />
                </DockPanel>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Tasten" />
                <DockPanel Classes="row">
                    <NumericUpDown DockPanel.Dock="Right" Value="{Binding LongPressMs}" Minimum="200" Maximum="3000"
                                   Increment="50" FormatString="0' ms'" MinWidth="140" />
                    <TextBlock Text="Langer Druck ab" />
                </DockPanel>
                <DockPanel Classes="row">
                    <NumericUpDown DockPanel.Dock="Right" Value="{Binding DoublePressMs}" Minimum="100" Maximum="1000"
                                   Increment="50" FormatString="0' ms'" MinWidth="140" />
                    <TextBlock Text="Doppeldruck innerhalb von" />
                </DockPanel>
                <TextBlock Classes="muted"
                           Text="Gilt nur für Tasten, die auch lang oder doppelt belegt sind. Bei allen anderen löst ein Druck sofort aus." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Slider" />
                <DockPanel Classes="row">
                    <NumericUpDown DockPanel.Dock="Right" Value="{Binding SliderDeadbandPercent}" Minimum="0" Maximum="25"
                                   Increment="1" FormatString="0' %'" MinWidth="140" />
                    <TextBlock Text="Toleranz bei Lautstärke-Slidern" />
                </DockPanel>
                <TextBlock Classes="muted"
                           Text="Kleinere Bewegungen werden ignoriert, damit die Lautstärke nicht zittert. 0 % und 100 % werden immer erreicht. Bei 0 % reagiert der Slider auf jede Änderung." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Entwicklermodus" />
                <DockPanel Classes="row">
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding DebugMode}" />
                    <TextBlock Text="Testhilfen einschalten" />
                </DockPanel>
                <TextBlock Classes="muted"
                           Text="Schaltet Startoptionen für Tests frei (Simulator ohne Hardware, Screenshots, Selbsttest der Tastenaufnahme) und zeigt zusätzliche Meldungen in der Diagnose. Die Startoptionen gelten ab dem nächsten Start der App; welche es gibt, steht dann auf der Diagnose-Seite." />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Konfigurationsdatei" />
                <TextBlock Classes="muted"
                           Text="Alles, was du hier und am Pad einstellst, steht in dieser Datei. Du kannst sie auch direkt bearbeiten; die App übernimmt Änderungen beim Speichern." />
                <SelectableTextBlock Text="{Binding ConfigPath}" FontSize="13.5" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="Datei öffnen" Command="{Binding OpenConfigCommand}" />
                    <Button Classes="quiet" Content="Ordner öffnen" Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Classes="caution" Text="{Binding Status}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
