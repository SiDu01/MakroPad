<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.SettingsView"
             x:DataType="vm:ShellViewModel">
    <ScrollViewer Classes="pageContent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                <TextBlock Classes="muted" Text="Erscheinungsbild und Konfigurationsdatei." />
            </StackPanel>

            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Pad-Layout" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Anzahl der Tasten-Zeilen und -Spalten sowie der Slider deines Geraets." />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Zeilen" />
                            <NumericUpDown Minimum="1" Maximum="12" Increment="1" Value="{Binding PadButtonRows}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="label" Text="Spalten" />
                            <NumericUpDown Minimum="1" Maximum="12" Increment="1" Value="{Binding PadButtonColumns}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Classes="label" Text="Slider" />
                            <NumericUpDown Minimum="0" Maximum="12" Increment="1" Value="{Binding PadSliderCount}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="muted" FontSize="12"
                               Text="{Binding PadButtonTotal, StringFormat='Insgesamt {0} Tasten'}" />
                </StackPanel>
            </Border>

            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Erscheinungsbild" FontSize="15" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Design" />
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding ThemeToggleHint}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding IsDarkTheme}"
                                      OnContent="Dunkel"
                                      OffContent="Hell" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Verhalten" FontSize="15" FontWeight="SemiBold" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Im Tray starten" />
                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                                       Text="Beim Start kein Fenster oeffnen, nur das Tray-Symbol. Ideal fuer den Autostart." />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      IsChecked="{Binding StartMinimizedToTray}"
                                      OnContent="An"
                                      OffContent="Aus" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Aenderung unten mit Speichern uebernehmen." />
                </StackPanel>
            </Border>

            <Border Classes="panel">
                <StackPanel Spacing="12">
                    <TextBlock Text="Konfiguration" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Classes="label" Text="Konfigurationsdatei" />
                    <TextBox Text="{Binding ConfigPath}" IsReadOnly="True" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Classes="primary" Content="Speichern"
                                Command="{Binding SaveConfigCommand}" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="secondary" Content="Neu laden"
                                Command="{Binding LoadConfigCommand}" HorizontalAlignment="Stretch" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="Action-Timeout, Volume-Deadband und Now Playing findest du unter Display › Runtime." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
