<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             xmlns:controls="using:MakroPad.App.Controls"
             x:Class="MakroPad.App.Views.SimulationView"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer Classes="pageContent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="16" MinWidth="520">
            <controls:PageHeader Title="Simulation"
                                 Subtitle="Inputs ohne Hardware ausloesen." />

            <Border Grid.Row="1" Classes="panel" HorizontalAlignment="Stretch">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Simulator" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding IsSimulatorSelected, StringFormat='Selected: {0}'}"
                                   Classes="muted" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Classes="label" Text="Button ID" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableButtonIds}"
                                  SelectedItem="{Binding SimulatorButtonId}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="secondary" Content="Simulate Button"
                                Command="{Binding SimulateButtonCommand}" />
                    </Grid>
                    <TextBlock Classes="label" Text="Slider ID" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding AvailableSliderIds}"
                                  SelectedItem="{Binding SimulatorSliderId}"
                                  HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Classes="secondary" Content="Simulate Slider"
                                Command="{Binding SimulateSliderCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding LastSliderValue, StringFormat='Last slider value: {0}'}" Classes="muted" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
