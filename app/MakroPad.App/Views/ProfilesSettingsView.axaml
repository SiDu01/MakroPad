<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             xmlns:controls="using:MakroPad.App.Controls"
             x:Class="MakroPad.App.Views.ProfilesSettingsView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="24,20,24,24">
        <controls:PageHeader Title="Einstellungen"
                             Subtitle="Profile verwalten."
                             ShowConfigActions="True" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Border Classes="panel" HorizontalAlignment="Stretch" MinWidth="560">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="18">
                    <TextBlock Text="Profiles" FontSize="16" FontWeight="SemiBold" />
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,150"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="12"
                          RowSpacing="12">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Active profile" />
                            <ComboBox ItemsSource="{Binding ProfilesEditor.ProfileNames}"
                                      SelectedItem="{Binding ProfilesEditor.ActiveProfileName}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="danger" Content="Delete"
                                Command="{Binding ProfilesEditor.DeleteProfileCommand}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" />
                        <StackPanel Grid.Row="1" Spacing="6">
                            <TextBlock Classes="label" Text="Profile name" />
                            <TextBox Text="{Binding ProfilesEditor.ProfileEditorName}" />
                        </StackPanel>
                        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8" VerticalAlignment="Bottom">
                            <Button Grid.Column="0" Classes="secondary" Content="Add"
                                    Command="{Binding ProfilesEditor.AddProfileCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="Rename"
                                    Command="{Binding ProfilesEditor.RenameProfileCommand}" HorizontalAlignment="Stretch" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
