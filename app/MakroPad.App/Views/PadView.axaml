<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.PadView"
             x:DataType="vm:ShellViewModel">

    <Grid RowDefinitions="Auto,*">

        <!-- Header: title, mode toggle, profile bar -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Margin="24,20,24,12"
              ColumnSpacing="16">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Classes="sectionTitle" Text="Pad" />
                <TextBlock Classes="muted" Text="Taste waehlen zum Bearbeiten – oder im Testmodus ausloesen." />
            </StackPanel>

            <Border Grid.Column="1" Classes="segmentTrack" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Classes="segment"
                            Classes.active="{Binding Pad.IsEditMode}"
                            Command="{Binding Pad.SetEditModeCommand}"
                            Content="Bearbeiten" />
                    <Button Classes="segment"
                            Classes.active="{Binding Pad.IsTestMode}"
                            Command="{Binding Pad.SetTestModeCommand}"
                            Content="Testen" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <TextBlock Classes="label" Text="Profil" VerticalAlignment="Center" />
                <ComboBox MinWidth="160"
                          ItemsSource="{Binding ProfilesEditor.ProfileNames}"
                          SelectedItem="{Binding ProfilesEditor.ActiveProfileName}" />
                <Button Classes="secondary" Content="Profile…">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="10" Width="248">
                                <TextBlock Classes="label" Text="Profilname" />
                                <TextBox Text="{Binding ProfilesEditor.ProfileEditorName}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Classes="primary"
                                            Content="Hinzufuegen"
                                            Command="{Binding ProfilesEditor.AddProfileCommand}" />
                                    <Button Classes="secondary"
                                            Content="Umbenennen"
                                            Command="{Binding ProfilesEditor.RenameProfileCommand}" />
                                </StackPanel>
                                <Button Classes="danger"
                                        HorizontalAlignment="Stretch"
                                        Content="Profil loeschen"
                                        Command="{Binding ProfilesEditor.DeleteProfileCommand}" />
                                <TextBlock Classes="muted"
                                           TextWrapping="Wrap"
                                           Text="{Binding ProfilesEditor.BindingEditorValidationMessage}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body: device grid + inspector -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" DataContext="{Binding Pad}">

            <ScrollViewer Grid.Column="0"
                          Classes="pageContent"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Left">

                    <!-- Button grid -->
                    <ItemsControl ItemsSource="{Binding Keys}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:KeyViewModel">
                                <Button Classes="keyTile"
                                        Classes.bound="{Binding HasBinding}"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectSlotCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Grid.Row="0" Classes="keyNumber" Text="{Binding Number}" />
                                        <TextBlock Grid.Row="1"
                                                   Classes="keyAction"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding ActionLabel}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Slider strips -->
                    <ItemsControl ItemsSource="{Binding Sliders}" VerticalAlignment="Top">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SliderViewModel">
                                <Button Classes="sliderStrip"
                                        Classes.bound="{Binding HasBinding}"
                                        Classes.selected="{Binding IsSelected}"
                                        Classes.active="{Binding IsActive}"
                                        Command="{Binding $parent[ItemsControl].DataContext.SelectSlotCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                                        <TextBlock Grid.Row="0"
                                                   Classes="keyNumber"
                                                   HorizontalAlignment="Center"
                                                   Text="{Binding Number}" />
                                        <Border Grid.Row="1"
                                                Width="8"
                                                HorizontalAlignment="Center"
                                                CornerRadius="4"
                                                Background="{DynamicResource AppBorderSubtleBrush}" />
                                        <TextBlock Grid.Row="2"
                                                   Classes="keyAction"
                                                   Text="{Binding ActionLabel}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Inspector -->
            <Border Grid.Column="1" Classes="inspector">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="sectionTitle"
                                       FontSize="18"
                                       Text="{Binding SelectedSlot.Label, FallbackValue='Inspector'}" />
                            <TextBlock Classes="muted"
                                       FontFamily="Consolas"
                                       Text="{Binding SelectedSlot.Input, FallbackValue='Keine Taste gewaehlt'}" />
                        </StackPanel>

                        <!-- Empty state -->
                        <TextBlock IsVisible="{Binding !HasSelection}"
                                   Classes="muted"
                                   TextWrapping="Wrap"
                                   Text="Waehle links eine Taste oder einen Slider, um eine Aktion zuzuweisen." />

                        <!-- Binding editor -->
                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="label" Text="Aktion" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Profiles.ActionEditor.AvailableActions}"
                                          SelectedItem="{Binding Profiles.ActionEditor.Action}" />
                            </StackPanel>

                            <!-- Structured parameter -->
                            <StackPanel IsVisible="{Binding Profiles.ActionEditor.HasStructuredParameter}" Spacing="6">
                                <TextBlock Classes="label" Text="{Binding Profiles.ActionEditor.StructuredParameterLabel}" />
                                <TextBox IsVisible="{Binding Profiles.ActionEditor.ShowsStructuredTextInput}"
                                         Text="{Binding Profiles.ActionEditor.StructuredParameterValue}" />
                                <ComboBox IsVisible="{Binding Profiles.ActionEditor.IsAppVolumeAction}"
                                          HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding Profiles.ActionEditor.AvailableAudioProcessNames}"
                                          SelectedItem="{Binding Profiles.ActionEditor.StructuredParameterValue}" />
                                <TextBlock Text="{Binding Profiles.ActionEditor.StructuredParameterValidationMessage}"
                                           Foreground="{DynamicResource AppWarningBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Specialized helpers -->
                            <Button IsVisible="{Binding Profiles.ActionEditor.IsKeyboardShortcutAction}"
                                    Classes="secondary"
                                    HorizontalAlignment="Stretch"
                                    Content="Shortcut aufnehmen"
                                    Command="{Binding Profiles.ActionEditor.StartShortcutRecordingCommand}" />
                            <Button IsVisible="{Binding Profiles.ActionEditor.IsOpenAppAction}"
                                    Classes="secondary"
                                    HorizontalAlignment="Stretch"
                                    Content="App/Datei waehlen"
                                    Click="BrowseOpenApp_Click" />

                            <!-- Raw parameters -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="label" Text="Parameter (roh)" VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Classes="secondary"
                                            Padding="10,4"
                                            Content="Beispiel"
                                            Command="{Binding Profiles.ActionEditor.UseParameterExampleCommand}" />
                                </Grid>
                                <TextBox PlaceholderText="{Binding Profiles.ActionEditor.ParameterPlaceholder}"
                                         Text="{Binding Profiles.ActionEditor.Parameters}" />
                            </StackPanel>

                            <!-- Hints / status -->
                            <TextBlock Text="{Binding Profiles.ActionEditor.ActionDescription}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Profiles.ActionEditor.ParameterHint}"
                                       Classes="muted"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Profiles.ActionEditor.ShortcutRecordingStatus}"
                                       Classes="muted"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Profiles.BindingEditorValidationMessage}"
                                       Foreground="{DynamicResource AppErrorBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />

                            <!-- Actions -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                                <Button Grid.Column="0"
                                        Classes="primary"
                                        HorizontalAlignment="Stretch"
                                        Content="Speichern"
                                        Command="{Binding SaveSlotCommand}" />
                                <Button Grid.Column="1"
                                        Classes="danger"
                                        Content="Leeren"
                                        Command="{Binding ClearSlotCommand}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
