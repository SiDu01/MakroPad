<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="MakroPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MakroPad"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        FontFamily="Outfit, Segoe UI"
        Foreground="#F7FBFF"
        Background="#061121">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F7FBFF" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9FB2C8" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#9FB2C8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#0B1A2D" />
            <Setter Property="BorderBrush" Value="#183655" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="#071528" />
            <Setter Property="BorderBrush" Value="#183655" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#061121" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#DCE8F7" />
            <Setter Property="Background" Value="#071528" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="190" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#102844" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem.settingsGroup">
            <Setter Property="Foreground" Value="#9FB2C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem.settingsSub">
            <Setter Property="Padding" Value="32,10,12,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="topBar"
                Padding="22,16">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  MaxWidth="1920"
                  HorizontalAlignment="Stretch">
                <TextBlock Text="MakroPad"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Classes="muted"
                           Text="{Binding SelectedPortDisplay, StringFormat='Port: {0}'}" />

                <Border Grid.Column="1"
                        Grid.RowSpan="2"
                        Background="#0B1A2D"
                        BorderBrush="#183655"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding ConnectionStatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    Margin="18"
                    MaxWidth="1920"
                    HorizontalAlignment="Stretch">
            <TabItem Header="Makros">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Makros" />
                            <TextBlock Classes="muted"
                                       Text="Bindings fuer Buttons und Slider bearbeiten." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="muted"
                                       Text="{Binding ActiveProfileName, StringFormat='Profil: {0}'}"
                                       VerticalAlignment="Center" />
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          RowDefinitions="*,Auto"
                          RowSpacing="16">
                        <Border Classes="panel">
                            <Grid RowDefinitions="Auto,*"
                                  RowSpacing="10">
                                <Grid ColumnDefinitions="150,220,*"
                                      ColumnSpacing="12">
                                    <TextBlock Text="Input"
                                               FontWeight="SemiBold"
                                               Classes="label" />
                                    <TextBlock Grid.Column="1"
                                               Text="Action"
                                               FontWeight="SemiBold"
                                               Classes="label" />
                                    <TextBlock Grid.Column="2"
                                               Text="Parameters"
                                               FontWeight="SemiBold"
                                               Classes="label" />
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ProfileBindings}"
                                         SelectedItem="{Binding SelectedBinding}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="150,220,*"
                                                  ColumnSpacing="12">
                                                <TextBlock Text="{Binding Input}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Action}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Parameters}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Classes="panel">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="150,220,*"
                                  RowSpacing="10"
                                  ColumnSpacing="12">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableInputs}"
                                          SelectedItem="{Binding BindingEditorInput}"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableActions}"
                                          SelectedItem="{Binding BindingEditorAction}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Grid.Column="2"
                                         PlaceholderText="{Binding BindingParameterPlaceholder}"
                                         Text="{Binding BindingEditorParameters}" />

                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Spacing="8">
                                    <StackPanel IsVisible="{Binding HasStructuredParameter}"
                                                Spacing="6">
                                        <TextBlock Classes="label"
                                                   Text="{Binding StructuredParameterLabel}" />
                                        <TextBox IsVisible="{Binding ShowsStructuredTextInput}"
                                                 Text="{Binding StructuredParameterValue}" />
                                        <ComboBox IsVisible="{Binding IsAppVolumeAction}"
                                                  ItemsSource="{Binding AvailableAudioProcessNames}"
                                                  SelectedItem="{Binding StructuredParameterValue}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding StructuredParameterValidationMessage}"
                                                   Foreground="#FFB86B"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding BindingActionDescription}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BindingParameterHint}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding BindingEditorValidationMessage}"
                                               Foreground="#FF7A90"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ShortcutRecordingStatus}"
                                               FontSize="12"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            IsVisible="{Binding IsKeyboardShortcutAction}"
                                            Content="Record Shortcut"
                                            Command="{Binding StartShortcutRecordingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            IsVisible="{Binding IsOpenAppAction}"
                                            Content="Browse App/File"
                                            Click="BrowseOpenApp_Click"
                                            HorizontalAlignment="Stretch" />
                                </Grid>

                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Content="Apply"
                                            Command="{Binding ApplyBindingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Add"
                                            Command="{Binding AddBindingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            Command="{Binding RemoveBindingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="3"
                                            Content="Example"
                                            Command="{Binding UseParameterExampleCommand}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Geraet">
                <ScrollViewer Margin="18,0,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Geraet" />
                            <TextBlock Classes="muted"
                                       Text="Serielle Verbindung und MakroPad-Status." />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <Border Classes="panel">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Connection"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Classes="label" Text="Port" />
                                    <ComboBox ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort}"
                                              HorizontalAlignment="Stretch" />

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Content="Refresh"
                                                Command="{Binding RefreshPortsCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Content="Connect"
                                                Command="{Binding ConnectCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <Button Content="Auto Connect"
                                            Command="{Binding AutoConnectCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Content="Disconnect"
                                            Command="{Binding DisconnectCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <CheckBox Content="Auto-connect on startup"
                                              IsChecked="{Binding AutoConnect}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="panel">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="OLED Media"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <CheckBox Content="Show Now Playing on OLED"
                                              IsChecked="{Binding EnableNowPlayingDisplay}" />
                                    <TextBlock Text="{Binding NowPlayingStatus}"
                                               TextWrapping="Wrap"
                                               Classes="muted" />
                                    <TextBlock Classes="label"
                                               Text="OLED message" />
                                    <TextBox Text="{Binding DisplayText}" />
                                    <Button Content="Send to Display"
                                            Command="{Binding SendDisplayMessageCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Simulation">
                <ScrollViewer Margin="18,0,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Simulation" />
                            <TextBlock Classes="muted"
                                       Text="Inputs ohne Hardware ausloesen." />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Classes="panel"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Simulator"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding IsSimulatorSelected, StringFormat='Selected: {0}'}"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Classes="label" Text="Button ID" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableButtonIds}"
                                              SelectedItem="{Binding SimulatorButtonId}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Simulate Button"
                                            Command="{Binding SimulateButtonCommand}" />
                                </Grid>

                                <TextBlock Classes="label" Text="Slider ID" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableSliderIds}"
                                              SelectedItem="{Binding SimulatorSliderId}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Simulate Slider"
                                            Command="{Binding SimulateSliderCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding LastSliderValue, StringFormat='Last slider value: {0}'}"
                                           Classes="muted" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Einstellungen"
                     Classes="settingsGroup"
                     IsEnabled="False" />

            <TabItem Header="Profiles"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                            <TextBlock Classes="muted"
                                       Text="Profile verwalten." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Border Classes="panel"
                                HorizontalAlignment="Stretch">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="18">
                                <TextBlock Text="Profiles"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,150"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="Active profile" />
                                        <ComboBox ItemsSource="{Binding ProfileNames}"
                                                  SelectedItem="{Binding ActiveProfileName}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Delete"
                                            Command="{Binding DeleteProfileCommand}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom" />

                                    <StackPanel Grid.Row="1"
                                                Spacing="6">
                                        <TextBlock Classes="label" Text="Profile name" />
                                        <TextBox Text="{Binding ProfileEditorName}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1"
                                          Grid.Column="1"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8"
                                          VerticalAlignment="Bottom">
                                        <Button Grid.Column="0"
                                                Content="Add"
                                                Command="{Binding AddProfileCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Content="Rename"
                                                Command="{Binding RenameProfileCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Application"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                            <TextBlock Classes="muted"
                                       Text="App-Verhalten konfigurieren." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Border Classes="panel"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Application"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ConfigPath}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Classes="muted" />
                                <TextBlock Classes="label"
                                           Text="Action result timeout (ms)" />
                                <NumericUpDown Value="{Binding ActionResultTimeoutMs}"
                                               Minimum="0"
                                               Maximum="60000"
                                               Increment="500" />
                                <TextBlock Classes="label"
                                           Text="Volume slider deadband (%)" />
                                <NumericUpDown Value="{Binding VolumeSliderDeadbandPercent}"
                                               Minimum="0"
                                               Maximum="25"
                                               Increment="1" />
                                <TextBlock Classes="muted"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="0 disables filtering. 2 suppresses adjacent-percent jitter." />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="OLED Default"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                            <TextBlock Classes="muted"
                                       Text="OLED-Startanzeige konfigurieren." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid ColumnDefinitions="*,300"
                              ColumnSpacing="16">
                            <Border Classes="panel">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="OLED Default Screen"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Classes="label" Text="Layout rows" />
                                    <ComboBox ItemsSource="{Binding AvailableOledLayoutRows}"
                                              SelectedItem="{Binding DefaultScreenRows}"
                                              HorizontalAlignment="Stretch" />
                                    <TextBlock Classes="label" Text="Title" />
                                    <TextBox Text="{Binding DefaultScreenTitle}" />
                                    <TextBlock Classes="label" Text="Line 1" />
                                    <TextBox Text="{Binding DefaultScreenLine1}" />
                                    <TextBlock Classes="label" Text="Line 2" />
                                    <TextBox Text="{Binding DefaultScreenLine2}" />
                                    <TextBlock IsVisible="{Binding UsesFiveLineOledLayout}"
                                               Classes="label"
                                               Text="Line 3" />
                                    <TextBox IsVisible="{Binding UsesFiveLineOledLayout}"
                                             Text="{Binding DefaultScreenLine3}" />
                                    <TextBlock IsVisible="{Binding UsesFiveLineOledLayout}"
                                               Classes="label"
                                               Text="Line 4" />
                                    <TextBox IsVisible="{Binding UsesFiveLineOledLayout}"
                                             Text="{Binding DefaultScreenLine4}" />
                                    <TextBlock Classes="muted"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="{}Placeholders: {profile}, {status}, {time}, {date}, {media.artist}, {media.title}, {media.track}, {volume.system}, {device.uptime}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Background="#02060C"
                                    BorderBrush="#2D5C88"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Width="256"
                                    Height="128"
                                    Padding="12"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top">
                                <StackPanel Spacing="6"
                                            VerticalAlignment="Top">
                                    <TextBlock Text="{Binding OledPreviewTitle}"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding OledPreviewLine1}"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding OledPreviewLine2}"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               TextWrapping="NoWrap" />
                                    <TextBlock IsVisible="{Binding UsesFiveLineOledLayout}"
                                               Text="{Binding OledPreviewLine3}"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               TextWrapping="NoWrap" />
                                    <TextBlock IsVisible="{Binding UsesFiveLineOledLayout}"
                                               Text="{Binding OledPreviewLine4}"
                                               FontFamily="Consolas"
                                               FontSize="16"
                                               TextWrapping="NoWrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Display Trigger"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                            <TextBlock Classes="muted"
                                       Text="Trigger fuer temporaere OLED-Anzeigen konfigurieren." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="*,Auto"
                              RowSpacing="16">
                            <Border Classes="panel">
                                <Grid RowDefinitions="Auto,*"
                                      RowSpacing="10">
                                    <Grid ColumnDefinitions="54,130,150,90,96,78,*"
                                          ColumnSpacing="12">
                                        <TextBlock Text="On"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Event"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                        <TextBlock Grid.Column="2"
                                                   Text="Match"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                        <TextBlock Grid.Column="3"
                                                   Text="Change"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                        <TextBlock Grid.Column="4"
                                                   Text="Duration"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                        <TextBlock Grid.Column="5"
                                                   Text="Mode"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                        <TextBlock Grid.Column="6"
                                                   Text="Content"
                                                   FontWeight="SemiBold"
                                                   Classes="label" />
                                    </Grid>

                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding DisplayTriggers}"
                                             SelectedItem="{Binding SelectedDisplayTrigger}"
                                             MinHeight="220">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="54,130,150,90,96,78,*"
                                                      ColumnSpacing="12">
                                                    <TextBlock Text="{Binding EnabledDisplay}"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding EventType}"
                                                               FontFamily="Consolas"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding MatchDisplay}"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding ChangePercent, StringFormat='{}{0}%'}"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding DurationMs, StringFormat='{}{0} ms'}"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding TemplateMode}"
                                                               FontFamily="Consolas" />
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding TemplateSummary}"
                                                               FontFamily="Consolas"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1"
                                    Classes="panel">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnDefinitions="120,140,140,*,256"
                                      RowSpacing="10"
                                      ColumnSpacing="12">
                                    <CheckBox Grid.Column="0"
                                              Content="Enabled"
                                              IsChecked="{Binding DisplayTriggerEditorEnabled}"
                                              VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding AvailableDisplayTriggerEventTypes}"
                                              SelectedItem="{Binding DisplayTriggerEditorEventType}"
                                              HorizontalAlignment="Stretch" />
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding AvailableDisplayTriggerInputs}"
                                              SelectedItem="{Binding DisplayTriggerEditorInput}"
                                              IsVisible="{Binding ShowsDisplayTriggerInputMatch}"
                                              HorizontalAlignment="Stretch" />
                                    <Grid Grid.Column="3"
                                          ColumnDefinitions="*,*,*,*"
                                          ColumnSpacing="8">
                                        <NumericUpDown Grid.Column="0"
                                                       Value="{Binding DisplayTriggerEditorMinPercent}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       Increment="1"
                                                       IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding DisplayTriggerEditorMaxPercent}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       Increment="1"
                                                       IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                        <NumericUpDown Grid.Column="2"
                                                       Value="{Binding DisplayTriggerEditorChangePercent}"
                                                       Minimum="0"
                                                       Maximum="100"
                                                       Increment="1"
                                                       IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                        <NumericUpDown Grid.Column="3"
                                                       Value="{Binding DisplayTriggerEditorDurationMs}"
                                                       Minimum="0"
                                                       Maximum="60000"
                                                       Increment="500" />
                                    </Grid>
                                    <Border Grid.Column="4"
                                            Grid.RowSpan="4"
                                            Background="#02060C"
                                            BorderBrush="#2D5C88"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Width="256"
                                            Height="128"
                                            Padding="12"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding DisplayTriggerPreviewLine1}"
                                                       FontFamily="Consolas"
                                                       FontSize="16"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggerPreviewLine2}"
                                                       FontFamily="Consolas"
                                                       FontSize="16"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggerPreviewLine3}"
                                                       FontFamily="Consolas"
                                                       FontSize="16"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggerPreviewLine4}"
                                                       FontFamily="Consolas"
                                                       FontSize="16"
                                                       TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggerPreviewLine5}"
                                                       FontFamily="Consolas"
                                                       FontSize="16"
                                                       TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="1"
                                          Grid.ColumnSpan="4"
                                          ColumnDefinitions="120,140,140,*"
                                          ColumnSpacing="12">
                                        <TextBlock Grid.Column="1"
                                                   Classes="label"
                                                   Text="Event type" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="label"
                                                   Text="Input match"
                                                   IsVisible="{Binding ShowsDisplayTriggerInputMatch}" />
                                        <Grid Grid.Column="3"
                                              ColumnDefinitions="*,*,*,*"
                                              ColumnSpacing="8">
                                            <TextBlock Classes="label"
                                                       Text="Min %"
                                                       IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="label"
                                                       Text="Max %"
                                                       IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                            <TextBlock Grid.Column="2"
                                                       Classes="label"
                                                       Text="Change threshold (%)"
                                                       IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                            <TextBlock Grid.Column="3"
                                                       Classes="label"
                                                       Text="Display duration (ms)" />
                                        </Grid>
                                    </Grid>

                                    <ComboBox Grid.Row="2"
                                              Grid.Column="1"
                                              ItemsSource="{Binding AvailableDisplayTemplateModes}"
                                              SelectedItem="{Binding DisplayTriggerEditorTemplateMode}"
                                              HorizontalAlignment="Stretch" />
                                    <ComboBox Grid.Row="2"
                                              Grid.Column="2"
                                              ItemsSource="{Binding AvailableDisplayTriggerConditions}"
                                              SelectedItem="{Binding DisplayTriggerEditorCondition}"
                                              IsVisible="{Binding IsSliderInputDisplayTrigger}"
                                              HorizontalAlignment="Stretch" />
                                    <Grid Grid.Row="2"
                                          Grid.Column="3"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <ComboBox ItemsSource="{Binding AvailableDisplayTriggerActionStatuses}"
                                                  SelectedItem="{Binding DisplayTriggerEditorActionStatus}"
                                                  IsVisible="{Binding IsActionResultDisplayTrigger}"
                                                  HorizontalAlignment="Stretch" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableDisplayTriggerConnectionStatuses}"
                                                  SelectedItem="{Binding DisplayTriggerEditorConnectionStatus}"
                                                  IsVisible="{Binding IsConnectionChangedDisplayTrigger}"
                                                  HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <Grid Grid.Row="3"
                                          Grid.ColumnSpan="4"
                                          ColumnDefinitions="120,140,140,*"
                                          ColumnSpacing="12">
                                        <TextBlock Grid.Column="1"
                                                   Classes="label"
                                                   Text="Mode" />
                                        <TextBlock Grid.Column="2"
                                                   Classes="label"
                                                   Text="Slider condition"
                                                   IsVisible="{Binding IsSliderInputDisplayTrigger}" />
                                        <Grid Grid.Column="3"
                                              ColumnDefinitions="*,*"
                                              ColumnSpacing="8">
                                            <TextBlock Classes="label"
                                                       Text="Action status"
                                                       IsVisible="{Binding IsActionResultDisplayTrigger}" />
                                            <TextBlock Grid.Column="1"
                                                       Classes="label"
                                                       Text="Connection status"
                                                       IsVisible="{Binding IsConnectionChangedDisplayTrigger}" />
                                        </Grid>
                                    </Grid>

                                    <TextBlock Grid.Row="4"
                                               Grid.ColumnSpan="4"
                                               Classes="label"
                                               Text="Display content" />
                                    <TextBox Grid.Row="5"
                                             Grid.ColumnSpan="4"
                                             Text="{Binding DisplayTriggerEditorTemplate}"
                                             AcceptsReturn="True"
                                             MinHeight="160"
                                             TextWrapping="Wrap" />
                                    <StackPanel Grid.Row="6"
                                                Grid.ColumnSpan="4"
                                                Spacing="8">
                                        <TextBlock Classes="muted"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Text="{}Placeholders: {slider.id}, {slider.value}, {slider.percent}, {action.status}, {action.name}, {action.message}, {media.artist}, {media.title}, {media.track}, {connection.status}, {input}, {profile}, {status}. HTML mode supports simple tags such as h1, p, br and li." />
                                        <TextBlock Text="{Binding DisplayTriggerEditorValidationMessage}"
                                                   Foreground="#FF7A90"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                        <WrapPanel>
                                            <Button Content="Apply"
                                                    Command="{Binding ApplyDisplayTriggerCommand}"
                                                    MinWidth="72"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Add"
                                                    Command="{Binding AddDisplayTriggerCommand}"
                                                    MinWidth="72"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Remove"
                                                    Command="{Binding RemoveDisplayTriggerCommand}"
                                                    MinWidth="72"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Test"
                                                    Command="{Binding TestDisplayTriggerCommand}"
                                                    MinWidth="72"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Up"
                                                    Command="{Binding MoveDisplayTriggerUpCommand}"
                                                    MinWidth="64"
                                                    Margin="0,0,8,8" />
                                            <Button Content="Down"
                                                    Command="{Binding MoveDisplayTriggerDownCommand}"
                                                    MinWidth="72"
                                                    Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Debug">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="Debug" />
                        <TextBlock Classes="muted"
                                   Text="Serielles Protokoll und interne Meldungen." />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="16">
                        <Border Classes="panel">
                            <Grid RowDefinitions="Auto,*"
                                  RowSpacing="12">
                                <TextBlock Text="Protocol Log"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding EventLog}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="panel">
                            <Grid RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Audio Sessions"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshAudioSessionsCommand}" />
                                </Grid>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,70,70"
                                      ColumnSpacing="8">
                                    <TextBlock Classes="label" Text="Process" />
                                    <TextBlock Grid.Column="1" Classes="label" Text="Volume" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="PID" />
                                </Grid>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding AudioSessionsStatus}"
                                           Classes="muted"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <ListBox Grid.Row="3"
                                         ItemsSource="{Binding AudioSessions}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,70,70"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding ProcessName}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding VolumePercent, StringFormat='{}{0}%'}"
                                                           FontFamily="Consolas" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ProcessId}"
                                                           FontFamily="Consolas" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
