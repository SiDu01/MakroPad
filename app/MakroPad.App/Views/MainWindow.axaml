<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="640"
        x:Class="MakroPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MakroPad"
        Width="980"
        Height="640"
        MinWidth="760"
        MinHeight="520">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="MakroPad"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Text="Companion app prototype"
                           Opacity="0.72" />
                <StackPanel Grid.Column="1"
                            Grid.RowSpan="2"
                            Orientation="Horizontal"
                            Spacing="8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Status:"
                               VerticalAlignment="Center"
                               Opacity="0.72" />
                    <TextBlock Text="{Binding ConnectionStatus}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20"
              ColumnDefinitions="320,*"
              RowDefinitions="Auto,Auto,*"
              ColumnSpacing="16"
              RowSpacing="16">
            <Border Grid.Column="0"
                    Grid.Row="0"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="12">
                    <TextBlock Text="Device"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <ComboBox ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding SelectedPort}"
                              HorizontalAlignment="Stretch" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Content="Refresh"
                                Command="{Binding RefreshPortsCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1"
                                Content="Connect"
                                Command="{Binding ConnectCommand}"
                                HorizontalAlignment="Stretch" />
                    </Grid>

                    <Button Content="Disconnect"
                            Command="{Binding DisconnectCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <Border Grid.Column="0"
                    Grid.Row="1"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="12">
                    <TextBlock Text="Test Controls"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <TextBlock Text="OLED message" Opacity="0.72" />
                    <TextBox Text="{Binding DisplayText}" />
                    <Button Content="Send to Display"
                            Command="{Binding SendDisplayMessageCommand}"
                            HorizontalAlignment="Stretch" />

                    <Separator />

                    <Button Content="Simulate Button 1"
                            Command="{Binding SimulateButtonCommand}"
                            HorizontalAlignment="Stretch" />
                    <Button Content="Simulate Slider 1"
                            Command="{Binding SimulateSliderCommand}"
                            HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding LastSliderValue, StringFormat='Last slider value: {0}'}"
                               Opacity="0.82" />
                </StackPanel>
            </Border>

            <Border Grid.Column="0"
                    Grid.Row="2"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="12">
                    <TextBlock Text="Profile"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <ComboBox ItemsSource="{Binding ProfileNames}"
                              SelectedItem="{Binding ActiveProfileName}"
                              HorizontalAlignment="Stretch" />

                    <TextBlock Text="{Binding ConfigPath}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Opacity="0.72" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Content="Load"
                                Command="{Binding LoadConfigCommand}"
                                HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1"
                                Content="Save"
                                Command="{Binding SaveConfigCommand}"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Grid.RowSpan="3"
                    Padding="16"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid RowDefinitions="Auto,180,Auto,*" RowSpacing="12">
                    <TextBlock Text="Profile Bindings"
                               FontSize="16"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="1"
                          RowDefinitions="Auto,*"
                          RowSpacing="6">
                        <Grid ColumnDefinitions="140,180,*"
                              ColumnSpacing="12">
                            <TextBlock Text="Input"
                                       FontWeight="SemiBold"
                                       Opacity="0.72" />
                            <TextBlock Grid.Column="1"
                                       Text="Action"
                                       FontWeight="SemiBold"
                                       Opacity="0.72" />
                            <TextBlock Grid.Column="2"
                                       Text="Parameters"
                                       FontWeight="SemiBold"
                                       Opacity="0.72" />
                        </Grid>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding ProfileBindings}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="140,180,*"
                                          ColumnSpacing="12">
                                        <TextBlock Text="{Binding Input}"
                                                   FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Action}"
                                                   FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Parameters}"
                                                   FontFamily="Consolas"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <TextBlock Grid.Row="2"
                               Text="Protocol Log"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding EventLog}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="NoWrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
