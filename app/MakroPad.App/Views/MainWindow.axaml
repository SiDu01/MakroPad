<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1120" d:DesignHeight="720"
        x:Class="MakroPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MakroPad"
        Width="1120"
        Height="720"
        MinWidth="900"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="22,16"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <TextBlock Text="MakroPad"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Text="{Binding SelectedPortDisplay, StringFormat='Port: {0}'}"
                           Opacity="0.72" />

                <Border Grid.Column="1"
                        Grid.RowSpan="2"
                        Padding="12,6"
                        BorderThickness="1"
                        CornerRadius="6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding ConnectionStatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="20"
              ColumnDefinitions="340,*"
              RowDefinitions="*"
              ColumnSpacing="18">
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Padding="16"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Device"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Port"
                                       Opacity="0.72" />
                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort}"
                                      HorizontalAlignment="Stretch" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Content="Refresh"
                                        Command="{Binding RefreshPortsCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Connect"
                                        Command="{Binding ConnectCommand}"
                                        HorizontalAlignment="Stretch" />
                            </Grid>

                            <Button Content="Auto Connect"
                                    Command="{Binding AutoConnectCommand}"
                                    HorizontalAlignment="Stretch" />

                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectCommand}"
                                    HorizontalAlignment="Stretch" />

                            <CheckBox Content="Auto-connect on startup"
                                      IsChecked="{Binding AutoConnect}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Profile"
                                       FontSize="16"
                                       FontWeight="SemiBold" />

                            <TextBlock Text="Active profile"
                                       Opacity="0.72" />
                            <ComboBox ItemsSource="{Binding ProfileNames}"
                                      SelectedItem="{Binding ActiveProfileName}"
                                      HorizontalAlignment="Stretch" />

                            <TextBlock Text="Profile name"
                                       Opacity="0.72" />
                            <TextBox Text="{Binding ProfileEditorName}" />

                            <Grid ColumnDefinitions="*,*,*"
                                  ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Content="Add"
                                        Command="{Binding AddProfileCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Rename"
                                        Command="{Binding RenameProfileCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2"
                                        Content="Delete"
                                        Command="{Binding DeleteProfileCommand}"
                                        HorizontalAlignment="Stretch" />
                            </Grid>

                            <TextBlock Text="{Binding ConfigPath}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />

                            <TextBlock Text="Action result timeout (ms)"
                                       Opacity="0.72" />
                            <NumericUpDown Value="{Binding ActionResultTimeoutMs}"
                                           Minimum="0"
                                           Maximum="60000"
                                           Increment="500" />

                            <CheckBox Content="Show Now Playing on OLED"
                                      IsChecked="{Binding EnableNowPlayingDisplay}" />
                            <TextBlock Text="{Binding NowPlayingStatus}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Opacity="0.72" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Content="Load"
                                        Command="{Binding LoadConfigCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Save"
                                        Command="{Binding SaveConfigCommand}"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Simulator"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding IsSimulatorSelected, StringFormat='Selected: {0}'}"
                                           Opacity="0.72"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Text="OLED message"
                                       Opacity="0.72" />
                            <TextBox Text="{Binding DisplayText}" />
                            <Button Content="Send to Display"
                                    Command="{Binding SendDisplayMessageCommand}"
                                    HorizontalAlignment="Stretch" />

                            <Separator />

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableButtonIds}"
                                          SelectedItem="{Binding SimulatorButtonId}"
                                          HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Simulate Button"
                                        Command="{Binding SimulateButtonCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding AvailableSliderIds}"
                                          SelectedItem="{Binding SimulatorSliderId}"
                                          HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Simulate Slider"
                                        Command="{Binding SimulateSliderCommand}" />
                            </Grid>

                            <TextBlock Text="{Binding LastSliderValue, StringFormat='Last slider value: {0}'}"
                                       Opacity="0.82" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1"
                  RowDefinitions="410,*"
                  RowSpacing="18">
                <Border Grid.Row="0"
                        Padding="16"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                        <TextBlock Text="Profile Bindings"
                                   FontSize="16"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Row="1"
                              RowDefinitions="Auto,*"
                              RowSpacing="6">
                            <Grid ColumnDefinitions="150,220,*"
                                  ColumnSpacing="12">
                                <TextBlock Text="Input"
                                           FontWeight="SemiBold"
                                           Opacity="0.72" />
                                <TextBlock Grid.Column="1"
                                           Text="Action"
                                           FontWeight="SemiBold"
                                           Opacity="0.72" />
                                <TextBlock Grid.Column="2"
                                           Text="Parameters"
                                           FontWeight="SemiBold"
                                           Opacity="0.72" />
                            </Grid>

                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding ProfileBindings}"
                                     SelectedItem="{Binding SelectedBinding}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="150,220,*"
                                              ColumnSpacing="12">
                                            <TextBlock Text="{Binding Input}"
                                                       FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Action}"
                                                       FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Parameters}"
                                                       FontFamily="Consolas"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Grid Grid.Row="2"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnDefinitions="150,220,*"
                              RowSpacing="8"
                              ColumnSpacing="12">
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding AvailableInputs}"
                                      SelectedItem="{Binding BindingEditorInput}"
                                      HorizontalAlignment="Stretch" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding AvailableActions}"
                                      SelectedItem="{Binding BindingEditorAction}"
                                      HorizontalAlignment="Stretch" />
                            <TextBox Grid.Column="2"
                                     PlaceholderText="{Binding BindingParameterPlaceholder}"
                                     Text="{Binding BindingEditorParameters}" />

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Spacing="3">
                                <TextBlock Text="{Binding BindingActionDescription}"
                                           Opacity="0.82"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BindingParameterHint}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Opacity="0.72"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BindingEditorValidationMessage}"
                                           Foreground="Firebrick"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ShortcutRecordingStatus}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="2"
                                  Grid.ColumnSpan="3"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Content="Record Shortcut"
                                        Command="{Binding StartShortcutRecordingCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Browse App/File"
                                        Click="BrowseOpenApp_Click"
                                        HorizontalAlignment="Stretch" />
                            </Grid>

                            <Grid Grid.Row="3"
                                  Grid.ColumnSpan="3"
                                  ColumnDefinitions="*,*,*,*"
                                  ColumnSpacing="8">
                                <Button Grid.Column="0"
                                        Content="Apply"
                                        Command="{Binding ApplyBindingCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="1"
                                        Content="Add"
                                        Command="{Binding AddBindingCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2"
                                        Content="Remove"
                                        Command="{Binding RemoveBindingCommand}"
                                        HorizontalAlignment="Stretch" />
                                <Button Grid.Column="3"
                                        Content="Example"
                                        Command="{Binding UseParameterExampleCommand}"
                                        HorizontalAlignment="Stretch" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="16"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <TextBlock Text="Protocol Log"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding EventLog}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
