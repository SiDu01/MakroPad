<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="MakroPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MakroPad"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        FontFamily="Outfit, Segoe UI"
        Foreground="#F7FBFF"
        Background="#061121">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#F7FBFF" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#9FB2C8" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#9FB2C8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#0B1A2D" />
            <Setter Property="BorderBrush" Value="#183655" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="MinWidth" Value="240" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="ComboBox.compact">
            <Setter Property="MinWidth" Value="70" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="#071528" />
            <Setter Property="BorderBrush" Value="#183655" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#061121" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#DCE8F7" />
            <Setter Property="Background" Value="#071528" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinWidth" Value="190" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#102844" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem.settingsGroup">
            <Setter Property="Foreground" Value="#9FB2C8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem.settingsSub">
            <Setter Property="Padding" Value="32,10,12,10" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Classes="topBar"
                Padding="22,16">
            <Grid ColumnDefinitions="*,Auto"
                  RowDefinitions="Auto,Auto"
                  MaxWidth="1920"
                  HorizontalAlignment="Stretch">
                <TextBlock Text="MakroPad"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Grid.Row="1"
                           Classes="muted"
                           Text="{Binding SelectedPortDisplay, StringFormat='Port: {0}'}" />

                <Border Grid.Column="1"
                        Grid.RowSpan="2"
                        Background="#0B1A2D"
                        BorderBrush="#183655"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{Binding ConnectionStatusBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionStatus}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    TabStripPlacement="Left"
                    Margin="18"
                    MaxWidth="1920"
                    HorizontalAlignment="Stretch">
            <TabItem Header="Makros">
                <ScrollViewer Margin="18,0,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      MinWidth="760">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Makros" />
                            <TextBlock Classes="muted"
                                       Text="Bindings fuer Buttons und Slider bearbeiten." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="muted"
                                       Text="{Binding ActiveProfileName, StringFormat='Profil: {0}'}"
                                       VerticalAlignment="Center" />
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1"
                          RowDefinitions="*,Auto"
                          RowSpacing="16">
                        <Border Classes="panel">
                            <Grid RowDefinitions="Auto,*"
                                  RowSpacing="10">
                                <Grid ColumnDefinitions="150,220,*"
                                      ColumnSpacing="12">
                                    <TextBlock Text="Input"
                                               FontWeight="SemiBold"
                                               Classes="label" />
                                    <TextBlock Grid.Column="1"
                                               Text="Action"
                                               FontWeight="SemiBold"
                                               Classes="label" />
                                    <TextBlock Grid.Column="2"
                                               Text="Parameters"
                                               FontWeight="SemiBold"
                                               Classes="label" />
                                </Grid>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding ProfilesEditor.ProfileBindings}"
                                         SelectedItem="{Binding ProfilesEditor.SelectedBinding}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="150,220,*"
                                                  ColumnSpacing="12">
                                                <TextBlock Text="{Binding Input}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Action}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Parameters}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                Classes="panel">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="150,220,*"
                                  RowSpacing="10"
                                  ColumnSpacing="12">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding ProfilesEditor.AvailableInputs}"
                                          SelectedItem="{Binding ProfilesEditor.BindingEditorInput}"
                                          HorizontalAlignment="Stretch" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding ProfilesEditor.ActionEditor.AvailableActions}"
                                          SelectedItem="{Binding ProfilesEditor.ActionEditor.Action}"
                                          HorizontalAlignment="Stretch" />
                                <TextBox Grid.Column="2"
                                         PlaceholderText="{Binding ProfilesEditor.ActionEditor.ParameterPlaceholder}"
                                         Text="{Binding ProfilesEditor.ActionEditor.Parameters}" />

                                <StackPanel Grid.Row="1"
                                            Grid.ColumnSpan="3"
                                            Spacing="8">
                                    <StackPanel IsVisible="{Binding ProfilesEditor.ActionEditor.HasStructuredParameter}"
                                                Spacing="6">
                                        <TextBlock Classes="label"
                                                   Text="{Binding ProfilesEditor.ActionEditor.StructuredParameterLabel}" />
                                        <TextBox IsVisible="{Binding ProfilesEditor.ActionEditor.ShowsStructuredTextInput}"
                                                 Text="{Binding ProfilesEditor.ActionEditor.StructuredParameterValue}" />
                                        <ComboBox IsVisible="{Binding ProfilesEditor.ActionEditor.IsAppVolumeAction}"
                                                  ItemsSource="{Binding ProfilesEditor.ActionEditor.AvailableAudioProcessNames}"
                                                  SelectedItem="{Binding ProfilesEditor.ActionEditor.StructuredParameterValue}"
                                                  HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding ProfilesEditor.ActionEditor.StructuredParameterValidationMessage}"
                                                   Foreground="#FFB86B"
                                                   FontSize="12"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProfilesEditor.ActionEditor.ActionDescription}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProfilesEditor.ActionEditor.ParameterHint}"
                                               FontFamily="Consolas"
                                               FontSize="12"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProfilesEditor.BindingEditorValidationMessage}"
                                               Foreground="#FF7A90"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProfilesEditor.ActionEditor.ShortcutRecordingStatus}"
                                               FontSize="12"
                                               Classes="muted"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            IsVisible="{Binding ProfilesEditor.ActionEditor.IsKeyboardShortcutAction}"
                                            Content="Record Shortcut"
                                            Command="{Binding ProfilesEditor.ActionEditor.StartShortcutRecordingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            IsVisible="{Binding ProfilesEditor.ActionEditor.IsOpenAppAction}"
                                            Content="Browse App/File"
                                            Click="BrowseOpenApp_Click"
                                            HorizontalAlignment="Stretch" />
                                </Grid>

                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="3"
                                      ColumnDefinitions="*,*,*,*"
                                      ColumnSpacing="8">
                                    <Button Grid.Column="0"
                                            Content="Apply"
                                            Command="{Binding ProfilesEditor.ApplyBindingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Add"
                                            Command="{Binding ProfilesEditor.AddBindingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            Command="{Binding ProfilesEditor.RemoveBindingCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="3"
                                            Content="Example"
                                            Command="{Binding ProfilesEditor.ActionEditor.UseParameterExampleCommand}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Geraet">
                <ScrollViewer Margin="18,0,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="16"
                          MinWidth="620">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Geraet" />
                            <TextBlock Classes="muted"
                                       Text="Serielle Verbindung und MakroPad-Status." />
                        </StackPanel>

                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <Border Classes="panel">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Connection"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Classes="label" Text="Port" />
                                    <ComboBox ItemsSource="{Binding AvailablePorts}"
                                              SelectedItem="{Binding SelectedPort}"
                                              HorizontalAlignment="Stretch" />

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Content="Refresh"
                                                Command="{Binding RefreshPortsCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Content="Connect"
                                                Command="{Binding ConnectCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>

                                    <Button Content="Auto Connect"
                                            Command="{Binding AutoConnectCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Content="Disconnect"
                                            Command="{Binding DisconnectCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <CheckBox Content="Auto-connect on startup"
                                              IsChecked="{Binding AutoConnect}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1"
                                    Classes="panel">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="OLED Media"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <CheckBox Content="Show Now Playing on OLED"
                                              IsChecked="{Binding DisplaySettings.EnableNowPlayingDisplay}" />
                                    <TextBlock Text="{Binding NowPlayingStatus}"
                                               TextWrapping="Wrap"
                                               Classes="muted" />
                                    <TextBlock Classes="label"
                                               Text="OLED message" />
                                    <TextBox Text="{Binding DisplayText}" />
                                    <Button Content="Send to Display"
                                            Command="{Binding SendDisplayMessageCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Simulation">
                <ScrollViewer Margin="18,0,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="16"
                          MinWidth="520">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Simulation" />
                            <TextBlock Classes="muted"
                                       Text="Inputs ohne Hardware ausloesen." />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Classes="panel"
                                HorizontalAlignment="Stretch">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Simulator"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding IsSimulatorSelected, StringFormat='Selected: {0}'}"
                                               Classes="muted"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock Classes="label" Text="Button ID" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableButtonIds}"
                                              SelectedItem="{Binding SimulatorButtonId}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Simulate Button"
                                            Command="{Binding SimulateButtonCommand}" />
                                </Grid>

                                <TextBlock Classes="label" Text="Slider ID" />
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">
                                    <ComboBox Grid.Column="0"
                                              ItemsSource="{Binding AvailableSliderIds}"
                                              SelectedItem="{Binding SimulatorSliderId}"
                                              HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1"
                                            Content="Simulate Slider"
                                            Command="{Binding SimulateSliderCommand}" />
                                </Grid>

                                <TextBlock Text="{Binding LastSliderValue, StringFormat='Last slider value: {0}'}"
                                           Classes="muted" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Einstellungen"
                     Classes="settingsGroup"
                     IsEnabled="False" />

            <TabItem Header="Profiles"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                            <TextBlock Classes="muted"
                                       Text="Profile verwalten." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Border Classes="panel"
                                HorizontalAlignment="Stretch"
                                MinWidth="560">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="18">
                                <TextBlock Text="Profiles"
                                           FontSize="16"
                                           FontWeight="SemiBold" />

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,150"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12"
                                      RowSpacing="12">
                                    <StackPanel Spacing="6">
                                        <TextBlock Classes="label" Text="Active profile" />
                                        <ComboBox ItemsSource="{Binding ProfilesEditor.ProfileNames}"
                                                  SelectedItem="{Binding ProfilesEditor.ActiveProfileName}"
                                                  HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Delete"
                                            Command="{Binding ProfilesEditor.DeleteProfileCommand}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom" />

                                    <StackPanel Grid.Row="1"
                                                Spacing="6">
                                        <TextBlock Classes="label" Text="Profile name" />
                                        <TextBox Text="{Binding ProfilesEditor.ProfileEditorName}" />
                                    </StackPanel>
                                    <Grid Grid.Row="1"
                                          Grid.Column="1"
                                          ColumnDefinitions="*,*"
                                          ColumnSpacing="8"
                                          VerticalAlignment="Bottom">
                                        <Button Grid.Column="0"
                                                Content="Add"
                                                Command="{Binding ProfilesEditor.AddProfileCommand}"
                                                HorizontalAlignment="Stretch" />
                                        <Button Grid.Column="1"
                                                Content="Rename"
                                                Command="{Binding ProfilesEditor.RenameProfileCommand}"
                                                HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Application"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Einstellungen" />
                            <TextBlock Classes="muted"
                                       Text="App-Verhalten konfigurieren." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Border Classes="panel"
                                HorizontalAlignment="Stretch"
                                MinWidth="420">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Application"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ConfigPath}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Classes="muted" />
                                <TextBlock Classes="label"
                                           Text="Action result timeout (ms)" />
                                <NumericUpDown Value="{Binding DisplaySettings.ActionResultTimeoutMs}"
                                               Minimum="0"
                                               Maximum="60000"
                                               Increment="500" />
                                <TextBlock Classes="label"
                                           Text="Volume slider deadband (%)" />
                                <NumericUpDown Value="{Binding DisplaySettings.VolumeSliderDeadbandPercent}"
                                               Minimum="0"
                                               Maximum="25"
                                               Increment="1" />
                                <TextBlock Classes="muted"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="0 disables filtering. 2 suppresses adjacent-percent jitter." />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="Display"
                     Classes="settingsSub">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      Margin="18,0,0,0">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Classes="sectionTitle" Text="Display" />
                            <TextBlock Classes="muted"
                                       Text="Idle-Screen und ereignisgesteuerte OLED-Screens gemeinsam konfigurieren." />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="Load"
                                    Command="{Binding LoadConfigCommand}" />
                            <Button Content="Save"
                                    Command="{Binding SaveConfigCommand}" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <Grid ColumnDefinitions="320,*,300"
                              ColumnSpacing="16"
                              MinWidth="1136">
                            <StackPanel Spacing="16"
                                        MinWidth="320">
                                <Border Classes="panel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Idle Screen"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="*,96"
                                              ColumnSpacing="8">
                                            <StackPanel Spacing="4">
                                                <TextBlock Classes="label" Text="Mode" />
                                                <ComboBox ItemsSource="{Binding DisplaySettings.AvailableOledTemplateModes}"
                                                          SelectedItem="{Binding DisplaySettings.DefaultScreenTemplateMode}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Classes="label" Text="Rows" />
                                                <ComboBox ItemsSource="{Binding DisplaySettings.AvailableOledLayoutRows}"
                                                          Classes="compact"
                                                          SelectedItem="{Binding DisplaySettings.DefaultScreenRows}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="label" Text="Title" />
                                        <Grid ColumnDefinitions="*,70" ColumnSpacing="8">
                                            <TextBox Text="{Binding DisplaySettings.DefaultScreenTitle}" />
                                            <ComboBox Grid.Column="1"
                                                      Classes="compact"
                                                      ItemsSource="{Binding DisplaySettings.AvailableOledTextSizes}"
                                                      SelectedItem="{Binding DisplaySettings.DefaultScreenTitleSize}" />
                                        </Grid>
                                        <TextBlock Classes="label" Text="Line 1" />
                                        <Grid ColumnDefinitions="*,70" ColumnSpacing="8">
                                            <TextBox Text="{Binding DisplaySettings.DefaultScreenLine1}" />
                                            <ComboBox Grid.Column="1"
                                                      Classes="compact"
                                                      ItemsSource="{Binding DisplaySettings.AvailableOledTextSizes}"
                                                      SelectedItem="{Binding DisplaySettings.DefaultScreenLine1Size}" />
                                        </Grid>
                                        <TextBlock Classes="label" Text="Line 2" />
                                        <Grid ColumnDefinitions="*,70" ColumnSpacing="8">
                                            <TextBox Text="{Binding DisplaySettings.DefaultScreenLine2}" />
                                            <ComboBox Grid.Column="1"
                                                      Classes="compact"
                                                      ItemsSource="{Binding DisplaySettings.AvailableOledTextSizes}"
                                                      SelectedItem="{Binding DisplaySettings.DefaultScreenLine2Size}" />
                                        </Grid>
                                        <TextBox Text="{Binding DisplaySettings.DefaultScreenLine3}"
                                                 PlaceholderText="Line 3"
                                                 IsVisible="{Binding DisplaySettings.UsesFiveLineOledLayout}" />
                                        <TextBox Text="{Binding DisplaySettings.DefaultScreenLine4}"
                                                 PlaceholderText="Line 4"
                                                 IsVisible="{Binding DisplaySettings.UsesFiveLineOledLayout}" />
                                    </StackPanel>
                                </Border>

                                <Border Classes="panel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Display Rules"
                                                   FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerPresets}"
                                                  SelectedItem="{Binding DisplayTriggersEditor.SelectedDisplayTriggerPreset}"
                                                  DisplayMemberBinding="{Binding Name}" />
                                        <Button Content="Use preset"
                                                Command="{Binding DisplayTriggersEditor.ApplyDisplayTriggerPresetCommand}" />
                                        <ListBox ItemsSource="{Binding DisplayTriggersEditor.DisplayTriggers}"
                                                 SelectedItem="{Binding DisplayTriggersEditor.SelectedDisplayTrigger}"
                                                 MinHeight="260">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                            <TextBlock Text="{Binding SequenceDisplay}" FontFamily="Consolas" Classes="muted" />
                                                            <TextBlock Grid.Column="1" Text="{Binding EventType}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding EnabledDisplay}" FontFamily="Consolas" Classes="muted" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding MatchDisplay}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding TemplateSummary}" FontFamily="Consolas" Classes="muted" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <WrapPanel>
                                            <Button Content="Add" Command="{Binding DisplayTriggersEditor.AddDisplayTriggerCommand}" MinWidth="72" Margin="0,0,8,8" />
                                            <Button Content="Duplicate" Command="{Binding DisplayTriggersEditor.DuplicateDisplayTriggerCommand}" MinWidth="92" Margin="0,0,8,8" />
                                            <Button Content="Remove" Command="{Binding DisplayTriggersEditor.RemoveDisplayTriggerCommand}" MinWidth="84" Margin="0,0,8,8" />
                                            <Button Content="Up" Command="{Binding DisplayTriggersEditor.MoveDisplayTriggerUpCommand}" MinWidth="56" Margin="0,0,8,8" />
                                            <Button Content="Down" Command="{Binding DisplayTriggersEditor.MoveDisplayTriggerDownCommand}" MinWidth="68" Margin="0,0,8,8" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" Classes="panel" MinWidth="500">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
                                    <TextBlock Text="Selected Screen Rule" FontSize="16" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,*,*" ColumnSpacing="10">
                                        <CheckBox Content="Enabled" IsChecked="{Binding DisplayTriggersEditor.DisplayTriggerEditorEnabled}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="4" MinWidth="130">
                                            <TextBlock Classes="label" Text="Event" />
                                            <ComboBox ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerEventTypes}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerEditorEventType}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" MinWidth="130" IsVisible="{Binding DisplayTriggersEditor.ShowsDisplayTriggerInputMatch}">
                                            <TextBlock Classes="label" Text="Input" />
                                            <ComboBox ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerInputs}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerEditorInput}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="4" MinWidth="130">
                                            <TextBlock Classes="label" Text="Display mode" />
                                            <ComboBox ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTemplateModes}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerEditorTemplateMode}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="4" MinWidth="104" IsVisible="{Binding DisplayTriggersEditor.IsSliderInputDisplayTrigger}">
                                            <TextBlock Classes="label" Text="Min %" />
                                            <NumericUpDown Value="{Binding DisplayTriggersEditor.DisplayTriggerEditorMinPercent}" Minimum="0" Maximum="100" Increment="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="4" MinWidth="104" IsVisible="{Binding DisplayTriggersEditor.IsSliderInputDisplayTrigger}">
                                            <TextBlock Classes="label" Text="Max %" />
                                            <NumericUpDown Value="{Binding DisplayTriggersEditor.DisplayTriggerEditorMaxPercent}" Minimum="0" Maximum="100" Increment="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="4" MinWidth="104" IsVisible="{Binding DisplayTriggersEditor.IsSliderInputDisplayTrigger}">
                                            <TextBlock Classes="label" Text="Change %" />
                                            <NumericUpDown Value="{Binding DisplayTriggersEditor.DisplayTriggerEditorChangePercent}" Minimum="0" Maximum="100" Increment="1" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="4" MinWidth="104">
                                            <TextBlock Classes="label" Text="Duration" />
                                            <NumericUpDown Value="{Binding DisplayTriggersEditor.DisplayTriggerEditorDurationMs}" Minimum="0" Maximum="60000" Increment="500" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <ComboBox ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerConditions}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerEditorCondition}" IsVisible="{Binding DisplayTriggersEditor.IsSliderInputDisplayTrigger}" />
                                        <ComboBox ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerActionStatuses}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerEditorActionStatus}" IsVisible="{Binding DisplayTriggersEditor.IsActionResultDisplayTrigger}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerConnectionStatuses}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerEditorConnectionStatus}" IsVisible="{Binding DisplayTriggersEditor.IsConnectionChangedDisplayTrigger}" />
                                    </Grid>

                                    <TextBlock Grid.Row="4" Classes="label" Text="Content" />
                                    <Grid Grid.Row="5" RowDefinitions="*,Auto,Auto" RowSpacing="10">
                                        <TextBox Text="{Binding DisplayTriggersEditor.DisplayTriggerEditorTemplate}" AcceptsReturn="True" MinHeight="220" TextWrapping="Wrap" />
                                        <Grid Grid.Row="1" ColumnDefinitions="Auto,130,130,130" ColumnSpacing="10" IsVisible="{Binding DisplayTriggersEditor.ShowsDisplayTriggerPreviewValues}">
                                            <TextBlock Classes="label" Text="Preview values" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Value="{Binding DisplayTriggersEditor.DisplayTriggerPreviewPercent}" Minimum="0" Maximum="100" Increment="1" IsVisible="{Binding DisplayTriggersEditor.IsSliderInputDisplayTrigger}" />
                                            <NumericUpDown Grid.Column="2" Value="{Binding DisplayTriggersEditor.DisplayTriggerPreviewPreviousPercent}" Minimum="0" Maximum="100" Increment="1" IsVisible="{Binding DisplayTriggersEditor.IsSliderInputDisplayTrigger}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerActionStatuses}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerPreviewActionStatus}" IsVisible="{Binding DisplayTriggersEditor.IsActionResultDisplayTrigger}" />
                                            <TextBox Grid.Column="2" Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewActionName}" PlaceholderText="Action" IsVisible="{Binding DisplayTriggersEditor.IsActionResultDisplayTrigger}" />
                                            <TextBox Grid.Column="3" Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewActionMessage}" PlaceholderText="Message" IsVisible="{Binding DisplayTriggersEditor.IsActionResultDisplayTrigger}" />
                                            <TextBox Grid.Column="1" Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewMediaArtist}" PlaceholderText="Artist" IsVisible="{Binding DisplayTriggersEditor.IsMediaChangedDisplayTrigger}" />
                                            <TextBox Grid.Column="2" Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewMediaTitle}" PlaceholderText="Track" IsVisible="{Binding DisplayTriggersEditor.IsMediaChangedDisplayTrigger}" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding DisplayTriggersEditor.AvailableDisplayTriggerConnectionStatuses}" SelectedItem="{Binding DisplayTriggersEditor.DisplayTriggerPreviewConnectionStatus}" IsVisible="{Binding DisplayTriggersEditor.IsConnectionChangedDisplayTrigger}" />
                                        </Grid>
                                        <StackPanel Grid.Row="2" Spacing="7">
                                            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding DisplayTriggersEditor.DisplayTriggerPlaceholderHint}" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewMatchStatus}" Foreground="#78D6A3" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="Unsaved editor changes" Foreground="#F0B55A" FontSize="12" IsVisible="{Binding DisplayTriggersEditor.IsDisplayTriggerEditorDirty}" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerEditorContentWarning}" Foreground="#F0B55A" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerSequenceInfo}" Foreground="#89B9E6" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerEditorValidationMessage}" Foreground="#E86D6D" FontSize="12" TextWrapping="Wrap" />
                                            <WrapPanel>
                                                <Button Content="Apply" Command="{Binding DisplayTriggersEditor.ApplyDisplayTriggerCommand}" MinWidth="78" Margin="0,0,8,8" />
                                                <Button Content="Reset" Command="{Binding DisplayTriggersEditor.ResetDisplayTriggerEditorCommand}" MinWidth="78" Margin="0,0,8,8" />
                                                <Button Content="Test" Command="{Binding DisplayTriggersEditor.TestDisplayTriggerCommand}" MinWidth="78" Margin="0,0,8,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="2" Spacing="16" MinWidth="300">
                                <Border Background="#02060C" BorderBrush="#2D5C88" BorderThickness="1" CornerRadius="4" Width="256" Height="128" Padding="12" HorizontalAlignment="Left">
                                    <StackPanel Spacing="6" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding DisplaySettings.OledPreviewTitle}" FontFamily="Consolas" FontSize="{Binding DisplaySettings.OledPreviewTitleFontSize}" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding DisplaySettings.OledPreviewLine1}" FontFamily="Consolas" FontSize="{Binding DisplaySettings.OledPreviewLine1FontSize}" TextWrapping="NoWrap" />
                                        <TextBlock Text="{Binding DisplaySettings.OledPreviewLine2}" FontFamily="Consolas" FontSize="{Binding DisplaySettings.OledPreviewLine2FontSize}" TextWrapping="NoWrap" />
                                        <TextBlock IsVisible="{Binding DisplaySettings.UsesFiveLineOledLayout}" Text="{Binding DisplaySettings.OledPreviewLine3}" FontFamily="Consolas" FontSize="{Binding DisplaySettings.OledPreviewLine3FontSize}" TextWrapping="NoWrap" />
                                        <TextBlock IsVisible="{Binding DisplaySettings.UsesFiveLineOledLayout}" Text="{Binding DisplaySettings.OledPreviewLine4}" FontFamily="Consolas" FontSize="{Binding DisplaySettings.OledPreviewLine4FontSize}" TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#02060C" BorderBrush="#2D5C88" BorderThickness="1" CornerRadius="4" Width="256" Height="128" Padding="12" HorizontalAlignment="Left">
                                    <Grid>
                                        <StackPanel Spacing="6" IsVisible="{Binding DisplayTriggersEditor.UsesTextDisplayPreview}">
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewLine1}" FontFamily="Consolas" FontSize="16" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewLine2}" FontFamily="Consolas" FontSize="16" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewLine3}" FontFamily="Consolas" FontSize="16" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewLine4}" FontFamily="Consolas" FontSize="16" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerPreviewLine5}" FontFamily="Consolas" FontSize="16" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <Grid RowDefinitions="18,*,16" IsVisible="{Binding DisplayTriggersEditor.UsesLayoutDisplayPreview}">
                                            <Border Background="#DDEBFF" CornerRadius="2" Padding="4,1">
                                                <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerLayoutPreviewTitle}" Foreground="#02060C" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="28,*" Margin="0,8,0,0">
                                                <Border Width="22" Height="22" BorderBrush="#DDEBFF" BorderThickness="1" IsVisible="{Binding DisplayTriggersEditor.HasDisplayTriggerLayoutPreviewIcon}">
                                                    <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerLayoutPreviewIcon}" Foreground="#DDEBFF" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerLayoutPreviewLine1}" FontFamily="Consolas" FontSize="15" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerLayoutPreviewLine2}" FontFamily="Consolas" FontSize="15" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding DisplayTriggersEditor.DisplayTriggerLayoutPreviewValueText}" FontFamily="Consolas" FontSize="22" IsVisible="{Binding DisplayTriggersEditor.ShowsDisplayTriggerLayoutPreviewValue}" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Grid.Row="2" Minimum="0" Maximum="100" Value="{Binding DisplayTriggersEditor.DisplayTriggerLayoutPreviewValue}" IsVisible="{Binding DisplayTriggersEditor.ShowsDisplayTriggerLayoutPreviewValue}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Classes="panel">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Runtime" FontWeight="SemiBold" />
                                        <CheckBox Content="Show Now Playing" IsChecked="{Binding DisplaySettings.EnableNowPlayingDisplay}" />
                                        <TextBlock Classes="label" Text="Action result timeout" />
                                        <NumericUpDown Value="{Binding DisplaySettings.ActionResultTimeoutMs}" Minimum="0" Maximum="60000" Increment="500" />
                                        <TextBlock Classes="label" Text="Volume deadband" />
                                        <NumericUpDown Value="{Binding DisplaySettings.VolumeSliderDeadbandPercent}" Minimum="0" Maximum="25" Increment="1" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Debug">
                <ScrollViewer Margin="18,0,0,0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="16"
                      MinWidth="760">
                    <StackPanel>
                        <TextBlock Classes="sectionTitle" Text="Debug" />
                        <TextBlock Classes="muted"
                                   Text="Serielles Protokoll und interne Meldungen." />
                    </StackPanel>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="16">
                        <Border Classes="panel">
                            <Grid RowDefinitions="Auto,*"
                                  RowSpacing="12">
                                <TextBlock Text="Protocol Log"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding EventLog}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="NoWrap" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Classes="panel">
                            <Grid RowDefinitions="Auto,Auto,Auto,*"
                                  RowSpacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Audio Sessions"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <Button Grid.Column="1"
                                            Content="Refresh"
                                            Command="{Binding RefreshAudioSessionsCommand}" />
                                </Grid>
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,70,70"
                                      ColumnSpacing="8">
                                    <TextBlock Classes="label" Text="Process" />
                                    <TextBlock Grid.Column="1" Classes="label" Text="Volume" />
                                    <TextBlock Grid.Column="2" Classes="label" Text="PID" />
                                </Grid>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding AudioSessionsStatus}"
                                           Classes="muted"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                <ListBox Grid.Row="3"
                                         ItemsSource="{Binding AudioSessions}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,70,70"
                                                  ColumnSpacing="8">
                                                <TextBlock Text="{Binding ProcessName}"
                                                           FontFamily="Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding VolumePercent, StringFormat='{}{0}%'}"
                                                           FontFamily="Consolas" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding ProcessId}"
                                                           FontFamily="Consolas" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
