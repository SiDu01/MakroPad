<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        xmlns:views="using:MakroPad.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="MakroPad.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/makropad.png"
        Title="MakroPad"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="topBar">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16"
                  MaxWidth="1920"
                  HorizontalAlignment="Stretch">
                <Border Width="40"
                        Height="40"
                        CornerRadius="10"
                        Background="{DynamicResource AppAccentSoftBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*,*" Margin="9">
                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="1" Grid.Column="2" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="2" Grid.Column="0" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                        <Border Grid.Row="2" Grid.Column="2" Background="{DynamicResource AppAccentBrush}" CornerRadius="1" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="brandTitle" Text="MakroPad" />
                    <TextBlock Classes="brandSubtitle" Text="Macro controller companion" />
                    <TextBlock Classes="muted"
                               Margin="0,4,0,0"
                               Text="{Binding SelectedPortDisplay, StringFormat='Port: {0}'}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <Button Classes="secondary icon"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip.Tip="{Binding ThemeToggleHint}">
                        <Panel>
                            <Path Classes="navIcon"
                                  IsVisible="{Binding IsDarkTheme}"
                                  Data="{StaticResource NavThemeLightIcon}" />
                            <Path Classes="navIcon"
                                  IsVisible="{Binding !IsDarkTheme}"
                                  Data="{StaticResource NavThemeDarkIcon}" />
                        </Panel>
                    </Button>

                    <Border Classes="statusPill">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse Width="9"
                                     Height="9"
                                     Fill="{Binding ConnectionStatusBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStatus}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    Classes="nav"
                    TabStripPlacement="Left"
                    Margin="0"
                    MaxWidth="1920"
                    HorizontalAlignment="Stretch">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="navIcon" Data="{StaticResource NavMacrosIcon}" />
                        <TextBlock Text="Makros" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:MacrosView />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="navIcon" Data="{StaticResource NavDeviceIcon}" />
                        <TextBlock Text="Geraet" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:DeviceView />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="navIcon" Data="{StaticResource NavSimulationIcon}" />
                        <TextBlock Text="Simulation" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:SimulationView />
            </TabItem>

            <TabItem Header="Einstellungen"
                     Classes="settingsGroup"
                     IsEnabled="False" />

            <TabItem Classes="settingsSub">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0">
                        <Path Classes="navIcon" Data="{StaticResource NavProfilesIcon}" />
                        <TextBlock Text="Profiles" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:ProfilesSettingsView />
            </TabItem>

            <TabItem Classes="settingsSub">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0">
                        <Path Classes="navIcon" Data="{StaticResource NavApplicationIcon}" />
                        <TextBlock Text="Application" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:ApplicationSettingsView />
            </TabItem>

            <TabItem Classes="settingsSub">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0">
                        <Path Classes="navIcon" Data="{StaticResource NavDisplayIcon}" />
                        <TextBlock Text="Display" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:DisplayEditorView />
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="navIcon" Data="{StaticResource NavDebugIcon}" />
                        <TextBlock Text="Debug" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <views:DebugView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
