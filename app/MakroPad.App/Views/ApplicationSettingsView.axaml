<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             xmlns:controls="using:MakroPad.App.Controls"
             x:Class="MakroPad.App.Views.ApplicationSettingsView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="24,20,24,24">
        <controls:PageHeader Title="Einstellungen"
                             Subtitle="App-Verhalten konfigurieren."
                             ShowConfigActions="True" />

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Border Classes="panel" HorizontalAlignment="Stretch" MinWidth="420">
                <StackPanel Spacing="12">
                    <TextBlock Text="Application" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ConfigPath}" FontSize="11" TextWrapping="Wrap" Classes="muted" />
                    <TextBlock Classes="label" Text="Action result timeout (ms)" />
                    <NumericUpDown Value="{Binding DisplaySettings.ActionResultTimeoutMs}"
                                   Minimum="0" Maximum="60000" Increment="500" />
                    <TextBlock Classes="label" Text="Volume slider deadband (%)" />
                    <NumericUpDown Value="{Binding DisplaySettings.VolumeSliderDeadbandPercent}"
                                   Minimum="0" Maximum="25" Increment="1" />
                    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                               Text="0 disables filtering. 2 suppresses adjacent-percent jitter." />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
