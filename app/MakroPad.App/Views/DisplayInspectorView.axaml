<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.DisplayInspectorView"
             x:DataType="vm:DisplayInspectorViewModel">
    <StackPanel Spacing="22">
        <StackPanel Spacing="8">
            <TextBlock Classes="h1" Text="Display" />
            <TextBlock Classes="muted"
                       Text="Hier siehst du live, was das Display am MakroPad gerade zeigt. Im Ruhezustand stehen dort Profil und Uhrzeit, darunter der laufende Titel oder das Datum." />
        </StackPanel>

        <DockPanel>
            <ToggleSwitch DockPanel.Dock="Right" OnContent="" OffContent="" MinWidth="0" VerticalAlignment="Center"
                          IsChecked="{Binding DisplayEnabled}" AutomationProperties.Name="Display eingeschaltet" />
            <StackPanel Spacing="2">
                <TextBlock Text="Display eingeschaltet" FontSize="15" />
                <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="Ausgeschaltet bleibt es dunkel, solange die App verbunden ist. Ohne App geht es wieder an." />
            </StackPanel>
        </DockPanel>

        <StackPanel Spacing="6">
            <StackPanel.Styles>
                <Style Selector="ToggleSwitch">
                    <Setter Property="OnContent" Value="" />
                    <Setter Property="OffContent" Value="" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
                <Style Selector="DockPanel > TextBlock">
                    <Setter Property="FontSize" Value="15" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </StackPanel.Styles>
            <TextBlock Classes="label" Text="Kurz einblenden" />
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Actions}" />
                <TextBlock Text="Nach einer Aktion" />
            </DockPanel>
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Volume}" />
                <TextBlock Text="Beim Ändern einer Lautstärke" />
            </DockPanel>
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Errors}" />
                <TextBlock Text="Wenn eine Aktion fehlschlägt" />
            </DockPanel>
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ProfileChange}" />
                <TextBlock Text="Beim Profilwechsel" />
            </DockPanel>
            <DockPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding TrackChange}" />
                <TextBlock Text="Bei einem neuen Titel" />
            </DockPanel>
        </StackPanel>

        <TextBlock Classes="muted" FontSize="12.5"
                   Text="Welcher Text eingeblendet wird, legst du bei der jeweiligen Taste unter „Beschriftung“ fest." />
    </StackPanel>
</UserControl>
