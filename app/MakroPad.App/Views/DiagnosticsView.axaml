<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.DiagnosticsView"
             x:DataType="vm:DiagnosticsViewModel">
    <Grid ColumnDefinitions="360,*" Margin="36,28,36,28">
        <ScrollViewer Margin="0,0,36,0">
            <StackPanel Spacing="30">
                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Verbindung" />
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid.Styles>
                            <Style Selector="TextBlock">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                            </Style>
                        </Grid.Styles>
                        <TextBlock Classes="muted" Text="Anschluss" />
                        <TextBlock Grid.Column="1" Text="{Binding Port}" />
                        <TextBlock Grid.Row="1" Classes="muted" Text="Firmware" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Firmware}" />
                        <TextBlock Grid.Row="2" Classes="muted" Text="Protokoll" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Protocol}" />
                        <TextBlock Grid.Row="3" Classes="muted" Text="Hardware" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware}" />
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Konfiguration" />
                    <TextBlock Classes="muted" Text="Keine Probleme gefunden." IsVisible="{Binding !HasConfigProblems}" />
                    <ItemsControl ItemsSource="{Binding ConfigProblems}" IsVisible="{Binding HasConfigProblems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Classes="caution" Text="{Binding}" Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="muted" FontSize="12.5" Text="{Binding ConfigPath}" />
                </StackPanel>

                <StackPanel Spacing="10">
                    <TextBlock Classes="h2" Text="Programme mit Audio" />
                    <TextBlock Classes="muted" Text="Diese Namen kannst du für die Programm-Lautstärke verwenden." />
                    <TextBlock Classes="muted" Text="Gerade spielt kein Programm Audio ab." IsVisible="{Binding !HasAudioSessions}" />
                    <ItemsControl ItemsSource="{Binding AudioSessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{Binding}" FontSize="14" Margin="0,0,0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="quiet" Content="Aktualisieren" Command="{Binding RefreshAudioCommand}" Margin="-10,0,0,0" />
                </StackPanel>

                <StackPanel Spacing="10" IsVisible="{Binding IsSimulator}">
                    <TextBlock Classes="h2" Text="Simulator" />
                    <TextBlock Classes="muted" Text="Die App läuft ohne Hardware. Diese Knöpfe ersetzen das MakroPad." />
                    <ItemsControl ItemsSource="{Binding SimulatorButtons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <Button Content="{Binding}" Width="48" Margin="0,0,6,6"
                                        Command="{Binding $parent[ItemsControl].((vm:DiagnosticsViewModel)DataContext).PressButtonCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="label" Text="Slider 1" />
                    <Slider Minimum="0" Maximum="1000" Value="{Binding SimulatorSlider}" />
                    <Button Content="Abziehen simulieren" Command="{Binding SimulateUnplugCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Column="1">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Classes="quiet" Content="Protokoll leeren" Command="{Binding ClearCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <TextBlock Classes="h2" Text="Protokoll" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Content="Vom Gerät" IsChecked="{Binding ShowDevice}" />
                    <CheckBox Content="An das Gerät" IsChecked="{Binding ShowApp}" />
                    <CheckBox Content="Aktionen" IsChecked="{Binding ShowActions}" />
                </StackPanel>
            </DockPanel>
            <Border Background="{DynamicResource LogBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="6">
                <ListBox ItemsSource="{Binding Entries}" Background="Transparent" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                            <Grid ColumnDefinitions="96,64,*">
                                <TextBlock Text="{Binding TimeText}" FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding KindText}" FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" />
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Text}" FontFamily="{StaticResource LogFont}"
                                                     FontSize="12.5" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
