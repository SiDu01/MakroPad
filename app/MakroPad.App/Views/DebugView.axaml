<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             xmlns:controls="using:MakroPad.App.Controls"
             x:Class="MakroPad.App.Views.DebugView"
             x:DataType="vm:MainWindowViewModel">
    <ScrollViewer Classes="pageContent"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,*" RowSpacing="16" MinWidth="760">
            <controls:PageHeader Title="Debug"
                                 Subtitle="Serielles Protokoll und interne Meldungen." />

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="panel">
                    <Grid RowDefinitions="Auto,*" RowSpacing="12">
                        <TextBlock Text="Protocol Log" FontSize="16" FontWeight="SemiBold" />
                        <ListBox Grid.Row="1" Classes="dataList" ItemsSource="{Binding EventLog}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="panel">
                    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Audio Sessions" FontSize="16" FontWeight="SemiBold" />
                            <Button Grid.Column="1" Classes="secondary" Content="Refresh"
                                    Command="{Binding RefreshAudioSessionsCommand}" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="*,70,70" ColumnSpacing="8">
                            <TextBlock Classes="label" Text="Process" />
                            <TextBlock Grid.Column="1" Classes="label" Text="Volume" />
                            <TextBlock Grid.Column="2" Classes="label" Text="PID" />
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding AudioSessionsStatus}"
                                   Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        <ListBox Grid.Row="3" Classes="dataList" ItemsSource="{Binding AudioSessions}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,70,70" ColumnSpacing="8">
                                        <TextBlock Text="{Binding ProcessName}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat='{}{0}%'}" FontFamily="Consolas" />
                                        <TextBlock Grid.Column="2" Text="{Binding ProcessId}" FontFamily="Consolas" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
