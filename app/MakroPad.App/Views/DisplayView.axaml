<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MakroPad.App.ViewModels"
             x:Class="MakroPad.App.Views.DisplayView"
             x:DataType="vm:ShellViewModel">
    <ScrollViewer Classes="pageContent">
        <StackPanel Spacing="16" MaxWidth="980" HorizontalAlignment="Left">
            <StackPanel Spacing="4">
                <TextBlock Classes="sectionTitle" Text="Display" />
                <TextBlock Classes="muted"
                           Text="OLED-Idle-Screen und Anzeige-Regeln mit Live-Vorschau." />
            </StackPanel>
            <Border Classes="panel">
                <TextBlock Classes="muted"
                           TextWrapping="Wrap"
                           Text="Der Display-Designer wird in einem spaeteren Schritt aufgebaut." />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
