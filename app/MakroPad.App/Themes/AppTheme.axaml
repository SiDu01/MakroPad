<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#080C12" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0F1724" />
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#152033" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#243247" />
                    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#1A2738" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#3B9EFF" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#1B3D66" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#F1F5FB" />
                    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#8FA3BC" />
                    <SolidColorBrush x:Key="AppTopBarBrush" Color="#101A28" />
                    <SolidColorBrush x:Key="AppListHoverBrush" Color="#142033" />
                    <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#1C2B42" />
                    <SolidColorBrush x:Key="AppDangerBackgroundBrush" Color="#3A1A22" />
                    <SolidColorBrush x:Key="AppDangerForegroundBrush" Color="#FFB4B4" />
                    <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#6A2A36" />
                    <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#4A202A" />
                    <SolidColorBrush x:Key="AppNavGroupBrush" Color="#6E829B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EEF2F7" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#D5DEE8" />
                    <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="AppAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#DBEAFE" />
                    <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#0F172A" />
                    <SolidColorBrush x:Key="AppTextMutedBrush" Color="#64748B" />
                    <SolidColorBrush x:Key="AppTopBarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppListHoverBrush" Color="#F1F5F9" />
                    <SolidColorBrush x:Key="AppSecondaryHoverBrush" Color="#E2E8F0" />
                    <SolidColorBrush x:Key="AppDangerBackgroundBrush" Color="#FEE2E2" />
                    <SolidColorBrush x:Key="AppDangerForegroundBrush" Color="#B91C1C" />
                    <SolidColorBrush x:Key="AppDangerBorderBrush" Color="#FECACA" />
                    <SolidColorBrush x:Key="AppDangerHoverBrush" Color="#FECACA" />
                    <SolidColorBrush x:Key="AppNavGroupBrush" Color="#94A3B8" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="AppSuccessBrush" Color="#5EE0A8" />
            <SolidColorBrush x:Key="AppWarningBrush" Color="#F0B55A" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#F08080" />
            <SolidColorBrush x:Key="AppOledFrameBrush" Color="#2A5F94" />
            <SolidColorBrush x:Key="AppOledBackgroundBrush" Color="#02060C" />
            <CornerRadius x:Key="AppRadiusSm">6</CornerRadius>
            <CornerRadius x:Key="AppRadiusMd">10</CornerRadius>
            <CornerRadius x:Key="AppRadiusLg">14</CornerRadius>
            <Thickness x:Key="AppPanelPadding">18</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="Inter, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.sectionTitle">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.2" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="TextBlock.brandTitle">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.4" />
    </Style>

    <Style Selector="TextBlock.brandSubtitle">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource AppPanelPadding}" />
        <Setter Property="MinWidth" Value="240" />
    </Style>

    <Style Selector="Border.panelElevated">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource AppPanelPadding}" />
    </Style>

    <Style Selector="Border.topBar">
        <Setter Property="Background" Value="{DynamicResource AppTopBarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="24,18" />
    </Style>

    <Style Selector="Border.statusPill">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <Style Selector="Border.oledPreview">
        <Setter Property="Background" Value="{StaticResource AppOledBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AppOledFrameBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Width" Value="256" />
        <Setter Property="Height" Value="128" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BoxShadow" Value="0 0 18 2 #203B5C88" />
    </Style>

    <Style Selector="Path.navIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource AppTextMutedBrush}" />
    </Style>

    <Style Selector="TabItem:selected Path.navIcon">
        <Setter Property="Fill" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSm}" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSm}" />
    </Style>

    <Style Selector="ComboBox.compact">
        <Setter Property="MinWidth" Value="70" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSm}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Width" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#5AADFF" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppSecondaryHoverBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource AppDangerBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppDangerForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppDangerBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AppDangerHoverBrush}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="28" />
    </Style>

    <Style Selector="TabControl.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="TabControl.nav TabStrip">
        <Setter Property="Width" Value="212" />
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="10,12" />
    </Style>

    <Style Selector="TabControl.nav > TabItem">
        <Setter Property="Foreground" Value="{DynamicResource AppTextMutedBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSm}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style Selector="TabControl.nav > TabItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource AppListHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
    </Style>

    <Style Selector="TabControl.nav > TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TabItem.settingsGroup">
        <Setter Property="Foreground" Value="{DynamicResource AppNavGroupBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,16,14,6" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <Style Selector="TabItem.settingsGroup:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource AppNavGroupBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="TabItem.settingsSub">
        <Setter Property="Padding" Value="28,10,12,10" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ListBox.dataList">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource AppRadiusSm}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ListBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
    </Style>

    <Style Selector="ListBoxItem:pointerover:not(:selected)">
        <Setter Property="Background" Value="{DynamicResource AppListHoverBrush}" />
    </Style>

    <Style Selector="ScrollViewer">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ScrollViewer.pageContent">
        <Setter Property="Margin" Value="24,20,24,24" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource AppBorderSubtleBrush}" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="6" />
    </Style>

</Styles>
