<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MakroPad.App.ViewModels"
        x:Class="MakroPad.App.AssignWindow"
        x:DataType="vm:AssignDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://MakroPad.App/Assets/makropad.ico"
        Width="460" SizeToContent="Height" MaxHeight="760" CanResize="False"
        Topmost="True" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="24,14"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
                    <Button Content="Abbrechen" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Classes="accent" Content="Speichern" Command="{Binding SaveCommand}" />
                </StackPanel>
                <TextBlock Classes="caution" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ScrollViewer Padding="24,22">
            <ContentControl Content="{Binding Editor}" />
        </ScrollViewer>
    </DockPanel>
</Window>
